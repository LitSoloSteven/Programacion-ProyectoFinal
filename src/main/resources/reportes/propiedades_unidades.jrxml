<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="propiedades_unidades" pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="782" leftMargin="30" rightMargin="30" topMargin="24" bottomMargin="24">

    <parameter name="TITULO_SISTEMA" class="java.lang.String"/>
    <parameter name="GENERADO_POR" class="java.lang.String"/>
    <parameter name="TOTAL_FILAS" class="java.lang.Integer"/>
    <parameter name="TOTAL_UNIDADES" class="java.lang.Integer"/>
    <parameter name="UNIDADES_OCUPADAS" class="java.lang.Integer"/>

    <field name="propiedad" class="java.lang.String"/>
    <field name="direccion" class="java.lang.String"/>
    <field name="estadoPropiedad" class="java.lang.String"/>
    <field name="codigoUnidad" class="java.lang.String"/>
    <field name="tipoUnidad" class="java.lang.String"/>
    <field name="estadoUnidad" class="java.lang.String"/>
    <field name="canonReferencia" class="java.math.BigDecimal"/>
    <field name="moneda" class="java.lang.String"/>

    <title height="94">
        <element kind="rectangle" x="0" y="0" width="782" height="42" backcolor="#0F172A">
            <pen lineWidth="0.0"/>
        </element>
        <element kind="textField" x="14" y="6" width="520" height="30" forecolor="#FFFFFF" vTextAlign="Middle" fontSize="15.0" bold="true">
            <expression><![CDATA[$P{TITULO_SISTEMA} == null ? "LATCH — Inventario de Propiedades y Unidades" : $P{TITULO_SISTEMA}]]></expression>
        </element>
        <element kind="textField" x="540" y="10" width="228" height="22" forecolor="#E2E8F0" hTextAlign="Right" vTextAlign="Middle" fontSize="9.5" bold="true">
            <expression><![CDATA["Unidades: " + ($P{UNIDADES_OCUPADAS} == null ? 0 : $P{UNIDADES_OCUPADAS}) + " ocupadas / " + ($P{TOTAL_UNIDADES} == null ? 0 : $P{TOTAL_UNIDADES}) + " total"]]></expression>
        </element>

        <element kind="rectangle" x="0" y="48" width="782" height="24" backcolor="#F1F5F9">
            <pen lineWidth="0.5" lineColor="#E2E8F0"/>
        </element>
        <element kind="textField" x="10" y="50" width="762" height="20" forecolor="#0F172A" vTextAlign="Middle" fontSize="9.0" bold="true">
            <expression><![CDATA["Registros en detalle: " + ($P{TOTAL_FILAS} == null ? 0 : $P{TOTAL_FILAS}) + "   |   Total unidades: " + ($P{TOTAL_UNIDADES} == null ? 0 : $P{TOTAL_UNIDADES}) + "   |   Ocupadas: " + ($P{UNIDADES_OCUPADAS} == null ? 0 : $P{UNIDADES_OCUPADAS})]]></expression>
        </element>

        <element kind="textField" x="0" y="74" width="782" height="16" forecolor="#475569" vTextAlign="Middle" fontSize="8.5">
            <expression><![CDATA["Generado por: " + ($P{GENERADO_POR} == null || $P{GENERADO_POR}.isBlank() ? "Sistema" : $P{GENERADO_POR})]]></expression>
        </element>
    </title>

    <columnHeader height="26">
        <element kind="rectangle" x="0" y="0" width="782" height="24" backcolor="#E2E8F0">
            <pen lineWidth="0.0"/>
        </element>
        <element kind="staticText" x="6" y="0" width="155" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="9.0" bold="true">
            <text><![CDATA[Propiedad]]></text>
        </element>
        <element kind="staticText" x="161" y="0" width="185" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="9.0" bold="true">
            <text><![CDATA[Dirección]]></text>
        </element>
        <element kind="staticText" x="346" y="0" width="75" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="9.0" bold="true">
            <text><![CDATA[Est. Prop.]]></text>
        </element>
        <element kind="staticText" x="421" y="0" width="85" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="9.0" bold="true">
            <text><![CDATA[Código]]></text>
        </element>
        <element kind="staticText" x="506" y="0" width="95" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="9.0" bold="true">
            <text><![CDATA[Tipo]]></text>
        </element>
        <element kind="staticText" x="601" y="0" width="81" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="9.0" bold="true">
            <text><![CDATA[Est. Unidad]]></text>
        </element>
        <element kind="staticText" x="682" y="0" width="94" height="24" forecolor="#0F172A" hTextAlign="Right" vTextAlign="Middle" fontSize="9.0" bold="true">
            <text><![CDATA[Canon ref.]]></text>
        </element>
    </columnHeader>

    <detail>
        <band height="24">
            <element kind="textField" x="6" y="2" width="155" height="18" forecolor="#1E293B" vTextAlign="Middle" fontSize="9.0" textAdjust="StretchHeight">
                <expression><![CDATA[$F{propiedad} == null || $F{propiedad}.isBlank() ? "—" : $F{propiedad}]]></expression>
            </element>
            <element kind="textField" x="161" y="2" width="185" height="18" forecolor="#334155" vTextAlign="Middle" fontSize="8.5" textAdjust="StretchHeight">
                <expression><![CDATA[$F{direccion} == null || $F{direccion}.isBlank() ? "—" : $F{direccion}]]></expression>
            </element>
            <element kind="textField" x="346" y="2" width="75" height="18" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.5" bold="true">
                <expression><![CDATA[$F{estadoPropiedad} == null || $F{estadoPropiedad}.isBlank() ? "—" : $F{estadoPropiedad}]]></expression>
            </element>
            <element kind="textField" x="421" y="2" width="85" height="18" forecolor="#1E293B" vTextAlign="Middle" fontSize="9.0" bold="true">
                <expression><![CDATA[$F{codigoUnidad} == null || $F{codigoUnidad}.isBlank() ? "—" : $F{codigoUnidad}]]></expression>
            </element>
            <element kind="textField" x="506" y="2" width="95" height="18" forecolor="#334155" vTextAlign="Middle" fontSize="8.5">
                <expression><![CDATA[$F{tipoUnidad} == null || $F{tipoUnidad}.isBlank() ? "—" : $F{tipoUnidad}]]></expression>
            </element>
            <element kind="textField" x="601" y="2" width="81" height="18" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.5" bold="true">
                <expression><![CDATA[$F{estadoUnidad} == null || $F{estadoUnidad}.isBlank() ? "—" : $F{estadoUnidad}]]></expression>
            </element>
            <element kind="textField" x="682" y="2" width="94" height="18" forecolor="#0F172A" hTextAlign="Right" vTextAlign="Middle" fontSize="9.0">
                <expression><![CDATA[($F{canonReferencia} == null ? "0.00" : $F{canonReferencia}.toPlainString()) + ($F{moneda} == null || $F{moneda}.isBlank() ? "" : " " + $F{moneda})]]></expression>
            </element>
            <element kind="line" x="0" y="22" width="782" height="1" forecolor="#E2E8F0">
                <pen lineWidth="0.5"/>
            </element>
        </band>
    </detail>

    <pageFooter height="22">
        <element kind="textField" x="0" y="2" width="660" height="18" forecolor="#64748B" vTextAlign="Middle" fontSize="8.5">
            <expression><![CDATA["Latch · Documento generado automáticamente"]]></expression>
        </element>
        <element kind="textField" x="660" y="2" width="90" height="18" forecolor="#64748B" hTextAlign="Right" vTextAlign="Middle" fontSize="8.5">
            <expression><![CDATA["Página " + $V{PAGE_NUMBER} + " de "]]></expression>
        </element>
        <element kind="textField" x="750" y="2" width="32" height="18" forecolor="#64748B" vTextAlign="Middle" fontSize="8.5" evaluationTime="Report">
            <expression><![CDATA[$V{PAGE_NUMBER}]]></expression>
        </element>
    </pageFooter>
</jasperReport>