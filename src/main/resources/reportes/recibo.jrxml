<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="recibo" pageWidth="595" pageHeight="842"
              columnWidth="535" leftMargin="30" rightMargin="30" topMargin="24" bottomMargin="24">

    <parameter name="TITULO_SISTEMA" class="java.lang.String"/>
    <parameter name="GENERADO_POR" class="java.lang.String"/>
    <parameter name="EMISOR_INFO" class="java.lang.String"/>
    <parameter name="NUMERO_RECIBO" class="java.lang.String"/>
    <parameter name="ESTADO_RECIBO" class="java.lang.String"/>
    <parameter name="TASA_INFO" class="java.lang.String"/>
    <parameter name="APLICACIONES_INFO" class="java.lang.String"/>
    <parameter name="CREDITO_INFO" class="java.lang.String"/>

    <field name="numero" class="java.lang.Long"/>
    <field name="pagoId" class="java.util.UUID"/>
    <field name="contratoId" class="java.util.UUID"/>
    <field name="fechaPago" class="java.time.LocalDate"/>
    <field name="contratoInfo" class="java.lang.String"/>
    <field name="montoOriginal" class="java.math.BigDecimal"/>
    <field name="monedaOriginal" class="java.lang.String"/>
    <field name="montoContrato" class="java.math.BigDecimal"/>
    <field name="monedaContrato" class="java.lang.String"/>
    <field name="metodo" class="java.lang.String"/>
    <field name="referencia" class="java.lang.String"/>
    <field name="anulado" class="java.lang.Boolean"/>

    <title height="88">
        <element kind="rectangle" x="0" y="0" width="535" height="42" backcolor="#0F172A">
            <pen lineWidth="0.0"/>
        </element>
        <element kind="textField" x="14" y="6" width="350" height="30" forecolor="#FFFFFF" vTextAlign="Middle" fontSize="15.0" bold="true">
            <expression><![CDATA[$P{TITULO_SISTEMA} == null ? "LATCH — Comprobante de Recibo" : $P{TITULO_SISTEMA}]]></expression>
        </element>
        <element kind="textField" x="370" y="10" width="151" height="22" forecolor="#E2E8F0" hTextAlign="Right" vTextAlign="Middle" fontSize="9.5" bold="true">
            <expression><![CDATA["Recibo N.º " + ($P{NUMERO_RECIBO} == null || $P{NUMERO_RECIBO}.isBlank() ? "—" : $P{NUMERO_RECIBO})]]></expression>
        </element>

        <element kind="textField" x="0" y="46" width="535" height="16" forecolor="#475569" vTextAlign="Middle" fontSize="8.5">
            <expression><![CDATA["Generado por: " + ($P{GENERADO_POR} == null || $P{GENERADO_POR}.isBlank() ? "Sistema" : $P{GENERADO_POR})]]></expression>
        </element>

        <element kind="rectangle" x="0" y="64" width="535" height="20" backcolor="#F1F5F9">
            <pen lineWidth="0.5" lineColor="#E2E8F0"/>
        </element>
        <element kind="textField" x="10" y="64" width="515" height="20" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.5" bold="true">
            <expression><![CDATA["Comprobante de pago   |   Estado: " + ($P{ESTADO_RECIBO} == null || $P{ESTADO_RECIBO}.isBlank() ? "VIGENTE" : $P{ESTADO_RECIBO})]]></expression>
        </element>
    </title>

    <detail>
        <band height="430">
            <element kind="rectangle" x="0" y="4" width="535" height="30" backcolor="#E2E8F0">
                <printWhenExpression><![CDATA[Boolean.TRUE.equals($F{anulado})]]></printWhenExpression>
                <pen lineWidth="1.5" lineColor="#0F172A"/>
            </element>
            <element kind="staticText" x="10" y="6" width="515" height="26" forecolor="#0F172A" hTextAlign="Center" vTextAlign="Middle" fontSize="11.0" bold="true">
                <printWhenExpression><![CDATA[Boolean.TRUE.equals($F{anulado})]]></printWhenExpression>
                <text><![CDATA[RECIBO ANULADO — SIN VALIDEZ PARA COBRO]]></text>
            </element>

            <element kind="staticText" x="0" y="44" width="120" height="16" forecolor="#475569" vTextAlign="Middle" fontSize="8.5" bold="true">
                <text><![CDATA[Número de recibo]]></text>
            </element>
            <element kind="textField" x="125" y="44" width="160" height="16" forecolor="#0F172A" vTextAlign="Middle" fontSize="9.5" bold="true">
                <expression><![CDATA["Recibo N.º " + ($F{numero} == null ? "—" : $F{numero}.toString())]]></expression>
            </element>

            <element kind="staticText" x="300" y="44" width="90" height="16" forecolor="#475569" vTextAlign="Middle" fontSize="8.5" bold="true">
                <text><![CDATA[Fecha de pago]]></text>
            </element>
            <element kind="textField" x="395" y="44" width="140" height="16" forecolor="#0F172A" hTextAlign="Right" vTextAlign="Middle" fontSize="9.5">
                <expression><![CDATA[$F{fechaPago} == null ? "—" : $F{fechaPago}.toString()]]></expression>
            </element>

            <element kind="line" x="0" y="66" width="535" height="1" forecolor="#E2E8F0">
                <pen lineWidth="0.5"/>
            </element>

            <element kind="staticText" x="0" y="74" width="120" height="16" forecolor="#475569" vTextAlign="Middle" fontSize="8.5" bold="true">
                <text><![CDATA[Contrato / Inquilino]]></text>
            </element>
            <element kind="textField" x="125" y="74" width="410" height="20" forecolor="#1E293B" vTextAlign="Middle" fontSize="9.5" textAdjust="StretchHeight">
                <expression><![CDATA[$F{contratoInfo} == null || $F{contratoInfo}.isBlank() ? "—" : $F{contratoInfo}]]></expression>
            </element>

            <element kind="line" x="0" y="100" width="535" height="1" forecolor="#E2E8F0">
                <pen lineWidth="0.5"/>
            </element>

            <element kind="staticText" x="0" y="108" width="120" height="16" forecolor="#475569" vTextAlign="Middle" fontSize="8.5" bold="true">
                <text><![CDATA[Método de pago]]></text>
            </element>
            <element kind="textField" x="125" y="108" width="160" height="16" forecolor="#1E293B" vTextAlign="Middle" fontSize="9.5">
                <expression><![CDATA[$F{metodo} == null || $F{metodo}.isBlank() ? "—" : $F{metodo}]]></expression>
            </element>

            <element kind="staticText" x="300" y="108" width="75" height="16" forecolor="#475569" vTextAlign="Middle" fontSize="8.5" bold="true">
                <text><![CDATA[Referencia]]></text>
            </element>
            <element kind="textField" x="380" y="108" width="155" height="16" forecolor="#1E293B" hTextAlign="Right" vTextAlign="Middle" fontSize="9.5" textAdjust="StretchHeight">
                <expression><![CDATA[$F{referencia} == null || $F{referencia}.isBlank() ? "—" : $F{referencia}]]></expression>
            </element>

            <element kind="rectangle" x="0" y="142" width="535" height="24" backcolor="#E2E8F0">
                <pen lineWidth="0.0"/>
            </element>
            <element kind="staticText" x="10" y="142" width="320" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="9.0" bold="true">
                <text><![CDATA[Concepto]]></text>
            </element>
            <element kind="staticText" x="335" y="142" width="190" height="24" forecolor="#0F172A" hTextAlign="Right" vTextAlign="Middle" fontSize="9.0" bold="true">
                <text><![CDATA[Importe]]></text>
            </element>

            <element kind="staticText" x="10" y="172" width="320" height="20" forecolor="#334155" vTextAlign="Middle" fontSize="9.5">
                <text><![CDATA[Monto original recibido]]></text>
            </element>
            <element kind="textField" x="335" y="172" width="190" height="20" forecolor="#0F172A" hTextAlign="Right" vTextAlign="Middle" fontSize="9.5" bold="true">
                <expression><![CDATA[(new java.text.DecimalFormat("#,##0.00", new java.text.DecimalFormatSymbols(java.util.Locale.US))).format($F{montoOriginal} == null ? java.math.BigDecimal.ZERO : $F{montoOriginal}) + ($F{monedaOriginal} == null || $F{monedaOriginal}.isBlank() ? "" : " " + $F{monedaOriginal})]]></expression>
            </element>
            <element kind="line" x="0" y="196" width="535" height="1" forecolor="#E2E8F0">
                <pen lineWidth="0.5"/>
            </element>

            <element kind="staticText" x="10" y="202" width="320" height="20" forecolor="#334155" vTextAlign="Middle" fontSize="9.5">
                <text><![CDATA[Monto aplicado al contrato]]></text>
            </element>
            <element kind="textField" x="335" y="202" width="190" height="20" forecolor="#0F172A" hTextAlign="Right" vTextAlign="Middle" fontSize="9.5" bold="true">
                <expression><![CDATA[(new java.text.DecimalFormat("#,##0.00", new java.text.DecimalFormatSymbols(java.util.Locale.US))).format($F{montoContrato} == null ? java.math.BigDecimal.ZERO : $F{montoContrato}) + ($F{monedaContrato} == null || $F{monedaContrato}.isBlank() ? "" : " " + $F{monedaContrato})]]></expression>
            </element>
            <element kind="line" x="0" y="226" width="535" height="1" forecolor="#E2E8F0">
                <pen lineWidth="0.5"/>
            </element>

            <element kind="staticText" x="10" y="232" width="130" height="18" forecolor="#475569" vTextAlign="Middle" fontSize="8.5" bold="true">
                <text><![CDATA[Tasa aplicada]]></text>
            </element>
            <element kind="textField" x="145" y="232" width="380" height="18" forecolor="#1E293B" hTextAlign="Right" vTextAlign="Middle" fontSize="8.5">
                <expression><![CDATA[$P{TASA_INFO} == null || $P{TASA_INFO}.isBlank() ? "Misma moneda" : $P{TASA_INFO}]]></expression>
            </element>

            <element kind="staticText" x="10" y="254" width="130" height="18" forecolor="#475569" vTextAlign="Middle" fontSize="8.5" bold="true">
                <text><![CDATA[Crédito a favor]]></text>
            </element>
            <element kind="textField" x="145" y="254" width="380" height="18" forecolor="#1E293B" hTextAlign="Right" vTextAlign="Middle" fontSize="8.5">
                <expression><![CDATA[$P{CREDITO_INFO} == null || $P{CREDITO_INFO}.isBlank() ? "0.00" : $P{CREDITO_INFO}]]></expression>
            </element>

            <element kind="staticText" x="10" y="276" width="130" height="18" forecolor="#475569" vTextAlign="Middle" fontSize="8.5" bold="true">
                <text><![CDATA[Cargos aplicados]]></text>
            </element>
            <element kind="textField" x="145" y="276" width="380" height="28" forecolor="#1E293B" hTextAlign="Right" vTextAlign="Middle" fontSize="8.5" textAdjust="StretchHeight">
                <expression><![CDATA[$P{APLICACIONES_INFO} == null || $P{APLICACIONES_INFO}.isBlank() ? "—" : $P{APLICACIONES_INFO}]]></expression>
            </element>

            <element kind="rectangle" x="0" y="318" width="535" height="72" backcolor="#F1F5F9">
                <pen lineWidth="0.5" lineColor="#E2E8F0"/>
            </element>
            <element kind="staticText" x="10" y="326" width="90" height="16" forecolor="#475569" vTextAlign="Middle" fontSize="8.5" bold="true">
                <text><![CDATA[ID Pago]]></text>
            </element>
            <element kind="textField" x="105" y="326" width="420" height="16" forecolor="#334155" vTextAlign="Middle" fontSize="8.5">
                <expression><![CDATA[$F{pagoId} == null ? "—" : $F{pagoId}.toString()]]></expression>
            </element>
            <element kind="staticText" x="10" y="346" width="90" height="16" forecolor="#475569" vTextAlign="Middle" fontSize="8.5" bold="true">
                <text><![CDATA[ID Contrato]]></text>
            </element>
            <element kind="textField" x="105" y="346" width="420" height="16" forecolor="#334155" vTextAlign="Middle" fontSize="8.5">
                <expression><![CDATA[$F{contratoId} == null ? "—" : $F{contratoId}.toString()]]></expression>
            </element>
            <element kind="staticText" x="10" y="366" width="90" height="16" forecolor="#475569" vTextAlign="Middle" fontSize="8.5" bold="true">
                <text><![CDATA[Emitido por]]></text>
            </element>
            <element kind="textField" x="105" y="366" width="420" height="16" forecolor="#334155" vTextAlign="Middle" fontSize="8.5" textAdjust="StretchHeight">
                <expression><![CDATA[$P{EMISOR_INFO} != null && !$P{EMISOR_INFO}.isBlank() ? $P{EMISOR_INFO} : ($P{GENERADO_POR} == null || $P{GENERADO_POR}.isBlank() ? "Sistema" : $P{GENERADO_POR})]]></expression>
            </element>
        </band>
    </detail>

    <pageFooter height="22">
        <element kind="textField" x="0" y="2" width="413" height="18" forecolor="#64748B" vTextAlign="Middle" fontSize="8.0">
            <expression><![CDATA["Latch · Comprobante administrativo — No es factura fiscal"]]></expression>
        </element>
        <element kind="textField" x="413" y="2" width="90" height="18" forecolor="#64748B" hTextAlign="Right" vTextAlign="Middle" fontSize="8.5">
            <expression><![CDATA["Página " + $V{PAGE_NUMBER} + " de "]]></expression>
        </element>
        <element kind="textField" x="503" y="2" width="32" height="18" forecolor="#64748B" vTextAlign="Middle" fontSize="8.5" evaluationTime="Report">
