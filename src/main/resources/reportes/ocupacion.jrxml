<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="ocupacion" pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="782" leftMargin="30" rightMargin="30" topMargin="24" bottomMargin="24"
              whenNoDataType="AllSectionsNoDetail">

    <parameter name="TITULO_SISTEMA" class="java.lang.String"/>
    <parameter name="GENERADO_POR" class="java.lang.String"/>
    <parameter name="INSTANTE_GENERACION" class="java.lang.String"/>
    <parameter name="FILTROS_TEXTO" class="java.lang.String"/>
    <parameter name="OCUPACION_RESUMEN" class="java.lang.String"/>
    <parameter name="DESGLOSE_ESTADOS" class="java.lang.String"/>

    <field name="propiedad" class="java.lang.String"/>
    <field name="codigoUnidad" class="java.lang.String"/>
    <field name="tipoUnidad" class="java.lang.String"/>
    <field name="estadoUnidad" class="java.lang.String"/>
    <field name="inquilinoOContrato" class="java.lang.String"/>
    <field name="moneda" class="java.lang.String"/>
    <field name="canonReferencia" class="java.math.BigDecimal"/>

    <title height="108">
        <element kind="rectangle" x="0" y="0" width="782" height="40" backcolor="#0F172A">
            <pen lineWidth="0.0"/>
        </element>
        <element kind="textField" x="14" y="5" width="490" height="30" forecolor="#FFFFFF" vTextAlign="Middle" fontSize="15.0" bold="true">
            <expression><![CDATA[$P{TITULO_SISTEMA} == null ? "LATCH — Ocupación Actual por Propiedad" : $P{TITULO_SISTEMA}]]></expression>
        </element>
        <element kind="textField" x="506" y="8" width="262" height="24" forecolor="#E2E8F0" hTextAlign="Right" vTextAlign="Middle" fontSize="9.0" bold="true">
            <expression><![CDATA[$P{OCUPACION_RESUMEN} == null ? "Ocupación: 0 / 0 (0.0%)" : $P{OCUPACION_RESUMEN}]]></expression>
        </element>
        <element kind="textField" x="0" y="44" width="782" height="16" forecolor="#475569" vTextAlign="Middle" fontSize="8.5">
            <expression><![CDATA["Instante de generación: " + ($P{INSTANTE_GENERACION} == null ? "—" : $P{INSTANTE_GENERACION}) + " · Generado por: " + ($P{GENERADO_POR} == null ? "Sistema" : $P{GENERADO_POR})]]></expression>
        </element>
        <element kind="rectangle" x="0" y="64" width="782" height="38" backcolor="#F1F5F9">
            <pen lineWidth="0.5" lineColor="#E2E8F0"/>
        </element>
        <element kind="textField" x="8" y="66" width="766" height="17" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.5" bold="true">
            <expression><![CDATA[$P{DESGLOSE_ESTADOS} == null ? "" : $P{DESGLOSE_ESTADOS}]]></expression>
        </element>
        <element kind="textField" x="8" y="83" width="766" height="16" forecolor="#475569" vTextAlign="Middle" fontSize="8.0">
            <expression><![CDATA[$P{FILTROS_TEXTO} == null ? "" : $P{FILTROS_TEXTO}]]></expression>
        </element>
    </title>

    <columnHeader height="26">
        <element kind="rectangle" x="0" y="0" width="782" height="24" backcolor="#E2E8F0">
            <pen lineWidth="0.0"/>
        </element>
        <element kind="staticText" x="6" y="0" width="160" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.5" bold="true">
            <text><![CDATA[Propiedad]]></text>
        </element>
        <element kind="staticText" x="166" y="0" width="84" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.5" bold="true">
            <text><![CDATA[Unidad]]></text>
        </element>
        <element kind="staticText" x="250" y="0" width="96" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.5" bold="true">
            <text><![CDATA[Tipo]]></text>
        </element>
        <element kind="staticText" x="346" y="0" width="98" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.5" bold="true">
            <text><![CDATA[Estado]]></text>
        </element>
        <element kind="staticText" x="444" y="0" width="194" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.5" bold="true">
            <text><![CDATA[Inquilino / Contrato activo]]></text>
        </element>
        <element kind="staticText" x="638" y="0" width="44" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.5" bold="true">
            <text><![CDATA[Mon.]]></text>
        </element>
        <element kind="staticText" x="682" y="0" width="94" height="24" forecolor="#0F172A" hTextAlign="Right" vTextAlign="Middle" fontSize="8.5" bold="true">
            <text><![CDATA[Canon ref.]]></text>
        </element>
    </columnHeader>

    <detail>
        <band height="24">
            <element kind="textField" x="6" y="2" width="160" height="18" forecolor="#1E293B" vTextAlign="Middle" fontSize="8.5" textAdjust="StretchHeight">
                <expression><![CDATA[$F{propiedad} == null ? "—" : $F{propiedad}]]></expression>
            </element>
            <element kind="textField" x="166" y="2" width="84" height="18" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.5" bold="true">
                <expression><![CDATA[$F{codigoUnidad} == null ? "—" : $F{codigoUnidad}]]></expression>
            </element>
            <element kind="textField" x="250" y="2" width="96" height="18" forecolor="#334155" vTextAlign="Middle" fontSize="8.5">
                <expression><![CDATA[$F{tipoUnidad} == null ? "—" : $F{tipoUnidad}]]></expression>
            </element>
            <element kind="textField" x="346" y="2" width="98" height="18" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.5" bold="true">
                <expression><![CDATA[$F{estadoUnidad} == null ? "—" : $F{estadoUnidad}]]></expression>
            </element>
            <element kind="textField" x="444" y="2" width="194" height="18" forecolor="#334155" vTextAlign="Middle" fontSize="8.5" textAdjust="StretchHeight">
                <expression><![CDATA[$F{inquilinoOContrato} == null ? "—" : $F{inquilinoOContrato}]]></expression>
            </element>
            <element kind="textField" x="638" y="2" width="44" height="18" forecolor="#334155" vTextAlign="Middle" fontSize="8.5">
                <expression><![CDATA[$F{moneda} == null ? "—" : $F{moneda}]]></expression>
            </element>
            <element kind="textField" x="682" y="2" width="94" height="18" forecolor="#0F172A" hTextAlign="Right" vTextAlign="Middle" fontSize="8.5" pattern="#,##0.00">
                <expression><![CDATA[$F{canonReferencia}]]></expression>
            </element>
            <element kind="line" x="0" y="22" width="782" height="1" forecolor="#E2E8F0">
                <pen lineWidth="0.5"/>
            </element>
        </band>
    </detail>

    <pageFooter height="22">
        <element kind="textField" x="0" y="2" width="660" height="18" forecolor="#64748B" vTextAlign="Middle" fontSize="8.5">
            <expression><![CDATA["Latch · Denominador: unidades activas (excluye Inactivas; incluye En mantenimiento)"]]></expression>
        </element>
        <element kind="textField" x="660" y="2" width="90" height="18" forecolor="#64748B" hTextAlign="Right" vTextAlign="Middle" fontSize="8.5">
            <expression><![CDATA["Página " + $V{PAGE_NUMBER} + " de "]]></expression>
        </element>
        <element kind="textField" x="750" y="2" width="32" height="18" forecolor="#64748B" vTextAlign="Middle" fontSize="8.5" evaluationTime="Report">
            <expression><![CDATA[$V{PAGE_NUMBER}]]></expression>
        </element>
    </pageFooter>
</jasperReport>
