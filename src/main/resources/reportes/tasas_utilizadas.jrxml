<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="tasas_utilizadas" pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="782" leftMargin="30" rightMargin="30" topMargin="24" bottomMargin="24"
              whenNoDataType="AllSectionsNoDetail">

    <parameter name="TITULO_SISTEMA" class="java.lang.String"/>
    <parameter name="GENERADO_POR" class="java.lang.String"/>
    <parameter name="FILTROS_TEXTO" class="java.lang.String"/>
    <parameter name="RESUMEN_TOTALES" class="java.lang.String"/>

    <field name="fechaPago" class="java.lang.String"/>
    <field name="numeroRecibo" class="java.lang.String"/>
    <field name="contrato" class="java.lang.String"/>
    <field name="montoOriginalTexto" class="java.lang.String"/>
    <field name="montoContratoTexto" class="java.lang.String"/>
    <field name="tasaAplicada" class="java.lang.String"/>
    <field name="fechaEfectivaTasa" class="java.lang.String"/>
    <field name="fuente" class="java.lang.String"/>
    <field name="autorizador" class="java.lang.String"/>
    <field name="estadoPago" class="java.lang.String"/>

    <title height="98">
        <element kind="rectangle" x="0" y="0" width="782" height="40" backcolor="#0F172A">
            <pen lineWidth="0.0"/>
        </element>
        <element kind="textField" x="14" y="5" width="540" height="30" forecolor="#FFFFFF" vTextAlign="Middle" fontSize="15.0" bold="true">
            <expression><![CDATA[$P{TITULO_SISTEMA} == null ? "LATCH — Tasas Utilizadas en Pagos" : $P{TITULO_SISTEMA}]]></expression>
        </element>
        <element kind="textField" x="556" y="8" width="212" height="24" forecolor="#CBD5E1" hTextAlign="Right" vTextAlign="Middle" fontSize="8.5">
            <expression><![CDATA["Solo tasas congeladas en pagos"]]></expression>
        </element>
        <element kind="textField" x="0" y="44" width="782" height="16" forecolor="#475569" vTextAlign="Middle" fontSize="8.5">
            <expression><![CDATA["Generado por: " + ($P{GENERADO_POR} == null ? "Sistema" : $P{GENERADO_POR}) + " · " + ($P{FILTROS_TEXTO} == null ? "" : $P{FILTROS_TEXTO})]]></expression>
        </element>
        <element kind="rectangle" x="0" y="64" width="782" height="26" backcolor="#F1F5F9">
            <pen lineWidth="0.5" lineColor="#E2E8F0"/>
        </element>
        <element kind="textField" x="8" y="66" width="766" height="22" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.5" bold="true">
            <expression><![CDATA[$P{RESUMEN_TOTALES} == null ? "Conversiones: 0" : $P{RESUMEN_TOTALES}]]></expression>
        </element>
    </title>

    <columnHeader height="26">
        <element kind="rectangle" x="0" y="0" width="782" height="24" backcolor="#E2E8F0">
            <pen lineWidth="0.0"/>
        </element>
        <element kind="staticText" x="4" y="0" width="60" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.0" bold="true">
            <text><![CDATA[Fecha pago]]></text>
        </element>
        <element kind="staticText" x="64" y="0" width="44" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.0" bold="true">
            <text><![CDATA[Recibo]]></text>
        </element>
        <element kind="staticText" x="108" y="0" width="132" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.0" bold="true">
            <text><![CDATA[Contrato / Inquilino]]></text>
        </element>
        <element kind="staticText" x="240" y="0" width="84" height="24" forecolor="#0F172A" hTextAlign="Right" vTextAlign="Middle" fontSize="8.0" bold="true">
            <text><![CDATA[Monto orig.]]></text>
        </element>
        <element kind="staticText" x="326" y="0" width="84" height="24" forecolor="#0F172A" hTextAlign="Right" vTextAlign="Middle" fontSize="8.0" bold="true">
            <text><![CDATA[Monto contr.]]></text>
        </element>
        <element kind="staticText" x="414" y="0" width="72" height="24" forecolor="#0F172A" hTextAlign="Right" vTextAlign="Middle" fontSize="8.0" bold="true">
            <text><![CDATA[Tasa NIO/USD]]></text>
        </element>
        <element kind="staticText" x="490" y="0" width="62" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.0" bold="true">
            <text><![CDATA[Fecha tasa]]></text>
        </element>
        <element kind="staticText" x="552" y="0" width="90" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.0" bold="true">
            <text><![CDATA[Fuente]]></text>
        </element>
        <element kind="staticText" x="642" y="0" width="86" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.0" bold="true">
            <text><![CDATA[Autorizador]]></text>
        </element>
        <element kind="staticText" x="728" y="0" width="54" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.0" bold="true">
            <text><![CDATA[Estado]]></text>
        </element>
    </columnHeader>

    <detail>
        <band height="24">
            <element kind="textField" x="4" y="2" width="60" height="18" forecolor="#334155" vTextAlign="Middle" fontSize="8.0">
                <expression><![CDATA[$F{fechaPago} == null ? "—" : $F{fechaPago}]]></expression>
            </element>
            <element kind="textField" x="64" y="2" width="44" height="18" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.0" bold="true">
                <expression><![CDATA[$F{numeroRecibo} == null ? "—" : $F{numeroRecibo}]]></expression>
            </element>
            <element kind="textField" x="108" y="2" width="132" height="18" forecolor="#1E293B" vTextAlign="Middle" fontSize="8.0" textAdjust="StretchHeight">
                <expression><![CDATA[$F{contrato} == null ? "—" : $F{contrato}]]></expression>
            </element>
            <element kind="textField" x="240" y="2" width="84" height="18" forecolor="#334155" hTextAlign="Right" vTextAlign="Middle" fontSize="8.0">
                <expression><![CDATA[$F{montoOriginalTexto} == null ? "—" : $F{montoOriginalTexto}]]></expression>
            </element>
            <element kind="textField" x="326" y="2" width="84" height="18" forecolor="#0F172A" hTextAlign="Right" vTextAlign="Middle" fontSize="8.0" bold="true">
                <expression><![CDATA[$F{montoContratoTexto} == null ? "—" : $F{montoContratoTexto}]]></expression>
            </element>
            <element kind="textField" x="414" y="2" width="72" height="18" forecolor="#0F172A" hTextAlign="Right" vTextAlign="Middle" fontSize="8.0" bold="true">
                <expression><![CDATA[$F{tasaAplicada} == null ? "—" : $F{tasaAplicada}]]></expression>
            </element>
            <element kind="textField" x="490" y="2" width="62" height="18" forecolor="#334155" vTextAlign="Middle" fontSize="8.0">
                <expression><![CDATA[$F{fechaEfectivaTasa} == null ? "—" : $F{fechaEfectivaTasa}]]></expression>
            </element>
            <element kind="textField" x="552" y="2" width="90" height="18" forecolor="#334155" vTextAlign="Middle" fontSize="8.0" textAdjust="StretchHeight">
                <expression><![CDATA[$F{fuente} == null ? "—" : $F{fuente}]]></expression>
            </element>
            <element kind="textField" x="642" y="2" width="86" height="18" forecolor="#334155" vTextAlign="Middle" fontSize="8.0" textAdjust="StretchHeight">
                <expression><![CDATA[$F{autorizador} == null ? "—" : $F{autorizador}]]></expression>
            </element>
            <element kind="textField" x="728" y="2" width="54" height="18" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.0" bold="true">
                <expression><![CDATA[$F{estadoPago} == null ? "—" : $F{estadoPago}]]></expression>
            </element>
            <element kind="line" x="0" y="22" width="782" height="1" forecolor="#E2E8F0">
                <pen lineWidth="0.5"/>
            </element>
        </band>
    </detail>

    <pageFooter height="22">
        <element kind="textField" x="0" y="2" width="660" height="18" forecolor="#64748B" vTextAlign="Middle" fontSize="8.5">
            <expression><![CDATA["Latch · Registro histórico de tasas aplicadas en pagos (sin redistribución del catálogo API externo)"]]></expression>
        </element>
        <element kind="textField" x="660" y="2" width="90" height="18" forecolor="#64748B" hTextAlign="Right" vTextAlign="Middle" fontSize="8.5">
            <expression><![CDATA["Página " + $V{PAGE_NUMBER} + " de "]]></expression>
        </element>
        <element kind="textField" x="750" y="2" width="32" height="18" forecolor="#64748B" vTextAlign="Middle" fontSize="8.5" evaluationTime="Report">
            <expression><![CDATA[$V{PAGE_NUMBER}]]></expression>
        </element>
    </pageFooter>
</jasperReport>
