<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="estado_cuenta" pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="782" leftMargin="30" rightMargin="30" topMargin="24" bottomMargin="24"
              summaryWithPageHeaderAndFooter="true">

    <parameter name="TITULO_SISTEMA" class="java.lang.String"/>
    <parameter name="GENERADO_POR" class="java.lang.String"/>
    <parameter name="CONTRATO_DESCRIPCION" class="java.lang.String"/>
    <parameter name="FECHA_CORTE" class="java.lang.String"/>
    <parameter name="MONEDA" class="java.lang.String"/>
    <parameter name="CANON" class="java.lang.String"/>
    <parameter name="TOTAL_CARGOS" class="java.lang.String"/>
    <parameter name="TOTAL_PAGADO" class="java.lang.String"/>
    <parameter name="TOTAL_SALDO" class="java.lang.String"/>
    <parameter name="TOTAL_CREDITO" class="java.lang.String"/>
    <parameter name="GARANTIA_PACTADA" class="java.lang.String"/>
    <parameter name="GARANTIA_SALDO" class="java.lang.String"/>
    <parameter name="TIENE_GARANTIA" class="java.lang.Boolean"/>

    <field name="seccion" class="java.lang.String"/>
    <field name="fecha" class="java.lang.String"/>
    <field name="referencia" class="java.lang.String"/>
    <field name="detalle" class="java.lang.String"/>
    <field name="importe" class="java.lang.String"/>
    <field name="aplicado" class="java.lang.String"/>
    <field name="saldoOCredito" class="java.lang.String"/>
    <field name="estado" class="java.lang.String"/>

    <group name="grupoSeccion">
        <expression><![CDATA[$F{seccion}]]></expression>
        <groupHeader>
            <band height="24">
                <element kind="rectangle" x="0" y="2" width="782" height="20" backcolor="#F1F5F9">
                    <pen lineWidth="0.5" lineColor="#E2E8F0"/>
                </element>
                <element kind="textField" x="10" y="2" width="762" height="20" forecolor="#0F172A" vTextAlign="Middle" fontSize="9.0" bold="true">
                    <expression><![CDATA["Sección: " + ($F{seccion} == null || $F{seccion}.isBlank() ? "Movimientos" : $F{seccion})]]></expression>
                </element>
            </band>
        </groupHeader>
    </group>

    <title height="94">
        <element kind="rectangle" x="0" y="0" width="782" height="42" backcolor="#0F172A">
            <pen lineWidth="0.0"/>
        </element>
        <element kind="textField" x="14" y="6" width="490" height="30" forecolor="#FFFFFF" vTextAlign="Middle" fontSize="15.0" bold="true">
            <expression><![CDATA[$P{TITULO_SISTEMA} == null ? "LATCH — Estado de Cuenta" : $P{TITULO_SISTEMA}]]></expression>
        </element>
        <element kind="textField" x="510" y="10" width="258" height="22" forecolor="#E2E8F0" hTextAlign="Right" vTextAlign="Middle" fontSize="9.5" bold="true">
            <expression><![CDATA["Moneda: " + ($P{MONEDA} == null ? "—" : $P{MONEDA}) + " · Canon: " + ($P{CANON} == null ? "0.00" : $P{CANON}) + " " + ($P{MONEDA} == null ? "" : $P{MONEDA})]]></expression>
        </element>

        <element kind="rectangle" x="0" y="48" width="782" height="24" backcolor="#F1F5F9">
            <pen lineWidth="0.5" lineColor="#E2E8F0"/>
        </element>
        <element kind="textField" x="10" y="50" width="762" height="20" forecolor="#0F172A" vTextAlign="Middle" fontSize="9.0" bold="true">
            <expression><![CDATA["Contrato: " + ($P{CONTRATO_DESCRIPCION} == null || $P{CONTRATO_DESCRIPCION}.isBlank() ? "—" : $P{CONTRATO_DESCRIPCION}) + "   |   Corte: " + ($P{FECHA_CORTE} == null ? "—" : $P{FECHA_CORTE}) + "   |   Saldo actual: " + ($P{TOTAL_SALDO} == null ? "0.00" : $P{TOTAL_SALDO}) + " " + ($P{MONEDA} == null ? "" : $P{MONEDA})]]></expression>
        </element>

        <element kind="textField" x="0" y="74" width="782" height="16" forecolor="#475569" vTextAlign="Middle" fontSize="8.5">
            <expression><![CDATA["Generado por: " + ($P{GENERADO_POR} == null || $P{GENERADO_POR}.isBlank() ? "Sistema" : $P{GENERADO_POR})]]></expression>
        </element>
    </title>

    <columnHeader height="26">
        <element kind="rectangle" x="0" y="0" width="782" height="24" backcolor="#E2E8F0">
            <pen lineWidth="0.0"/>
        </element>
        <element kind="staticText" x="6" y="0" width="84" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.5" bold="true">
            <text><![CDATA[Fecha]]></text>
        </element>
        <element kind="staticText" x="90" y="0" width="95" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.5" bold="true">
            <text><![CDATA[Referencia]]></text>
        </element>
        <element kind="staticText" x="185" y="0" width="247" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.5" bold="true">
            <text><![CDATA[Detalle]]></text>
        </element>
        <element kind="staticText" x="432" y="0" width="90" height="24" forecolor="#0F172A" hTextAlign="Right" vTextAlign="Middle" fontSize="8.5" bold="true">
            <text><![CDATA[Importe]]></text>
        </element>
        <element kind="staticText" x="522" y="0" width="90" height="24" forecolor="#0F172A" hTextAlign="Right" vTextAlign="Middle" fontSize="8.5" bold="true">
            <text><![CDATA[Aplicado]]></text>
        </element>
        <element kind="staticText" x="612" y="0" width="95" height="24" forecolor="#0F172A" hTextAlign="Right" vTextAlign="Middle" fontSize="8.5" bold="true">
            <text><![CDATA[Saldo / Crédito]]></text>
        </element>
        <element kind="staticText" x="712" y="0" width="70" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.5" bold="true">
            <text><![CDATA[Estado]]></text>
        </element>
    </columnHeader>

    <detail>
        <band height="24">
            <element kind="textField" x="6" y="2" width="84" height="18" forecolor="#334155" vTextAlign="Middle" fontSize="8.5">
                <expression><![CDATA[$F{fecha} == null || $F{fecha}.isBlank() ? "—" : $F{fecha}]]></expression>
            </element>
            <element kind="textField" x="90" y="2" width="95" height="18" forecolor="#334155" vTextAlign="Middle" fontSize="8.5" textAdjust="StretchHeight">
                <expression><![CDATA[$F{referencia} == null || $F{referencia}.isBlank() ? "—" : $F{referencia}]]></expression>
            </element>
            <element kind="textField" x="185" y="2" width="247" height="18" forecolor="#1E293B" vTextAlign="Middle" fontSize="8.5" textAdjust="StretchHeight">
                <expression><![CDATA[$F{detalle} == null || $F{detalle}.isBlank() ? "—" : $F{detalle}]]></expression>
            </element>
            <element kind="textField" x="432" y="2" width="90" height="18" forecolor="#0F172A" hTextAlign="Right" vTextAlign="Middle" fontSize="8.5">
                <expression><![CDATA[$F{importe} == null || $F{importe}.isBlank() ? "—" : $F{importe}]]></expression>
            </element>
            <element kind="textField" x="522" y="2" width="90" height="18" forecolor="#334155" hTextAlign="Right" vTextAlign="Middle" fontSize="8.5">
                <expression><![CDATA[$F{aplicado} == null || $F{aplicado}.isBlank() ? "—" : $F{aplicado}]]></expression>
            </element>
            <element kind="textField" x="612" y="2" width="95" height="18" forecolor="#0F172A" hTextAlign="Right" vTextAlign="Middle" fontSize="8.5">
                <expression><![CDATA[$F{saldoOCredito} == null || $F{saldoOCredito}.isBlank() ? "—" : $F{saldoOCredito}]]></expression>
            </element>
            <element kind="textField" x="712" y="2" width="70" height="18" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.5" bold="true">
                <expression><![CDATA[$F{estado} == null || $F{estado}.isBlank() ? "—" : $F{estado}]]></expression>
            </element>
            <element kind="line" x="0" y="22" width="782" height="1" forecolor="#E2E8F0">
                <pen lineWidth="0.5"/>
            </element>
        </band>
    </detail>

    <summary height="72" splitType="Prevent">
        <element kind="rectangle" x="0" y="8" width="782" height="26" backcolor="#F1F5F9">
            <pen lineWidth="0.5" lineColor="#E2E8F0"/>
        </element>
        <element kind="textField" x="10" y="10" width="762" height="22" forecolor="#0F172A" vTextAlign="Middle" fontSize="9.0" bold="true">
            <expression><![CDATA["Totales del contrato (" + ($P{MONEDA} == null ? "—" : $P{MONEDA}) + ")   |   Cargos: " + ($P{TOTAL_CARGOS} == null ? "0.00" : $P{TOTAL_CARGOS}) + " " + ($P{MONEDA} == null ? "" : $P{MONEDA}) + "   |   Pagado: " + ($P{TOTAL_PAGADO} == null ? "0.00" : $P{TOTAL_PAGADO}) + " " + ($P{MONEDA} == null ? "" : $P{MONEDA}) + "   |   Saldo: " + ($P{TOTAL_SALDO} == null ? "0.00" : $P{TOTAL_SALDO}) + " " + ($P{MONEDA} == null ? "" : $P{MONEDA}) + "   |   Crédito: " + ($P{TOTAL_CREDITO} == null ? "0.00" : $P{TOTAL_CREDITO}) + " " + ($P{MONEDA} == null ? "" : $P{MONEDA})]]></expression>
        </element>

        <element kind="rectangle" x="0" y="40" width="782" height="26" backcolor="#F1F5F9">
            <pen lineWidth="0.5" lineColor="#E2E8F0"/>
        </element>
        <element kind="textField" x="10" y="42" width="762" height="22" forecolor="#0F172A" vTextAlign="Middle" fontSize="9.0" bold="true">
            <expression><![CDATA[Boolean.TRUE.equals($P{TIENE_GARANTIA}) ? ("Depósito en garantía (separado de renta)   |   Pactada: " + ($P{GARANTIA_PACTADA} == null ? "0.00" : $P{GARANTIA_PACTADA}) + " " + ($P{MONEDA} == null ? "" : $P{MONEDA}) + "   |   Saldo actual: " + ($P{GARANTIA_SALDO} == null ? "0.00" : $P{GARANTIA_SALDO}) + " " + ($P{MONEDA} == null ? "" : $P{MONEDA})) : "Depósito en garantía (separado de renta)   |   Sin garantía registrada"]]></expression>
        </element>
    </summary>

    <pageFooter height="22">
        <element kind="textField" x="0" y="2" width="660" height="18" forecolor="#64748B" vTextAlign="Middle" fontSize="8.5">
            <expression><![CDATA["Latch · Documento generado automáticamente"]]></expression>
        </element>
        <element kind="textField" x="660" y="2" width="90" height="18" forecolor="#64748B" hTextAlign="Right" vTextAlign="Middle" fontSize="8.5">
            <expression><![CDATA["Página " + $V{PAGE_NUMBER} + " de "]]></expression>
        </element>
        <element kind="textField" x="750" y="2" width="32" height="18" forecolor="#64748B" vTextAlign="Middle" fontSize="8.5" evaluationTime="Report">
            <expression><![CDATA[$V{PAGE_NUMBER}]]></expression>
        </element>
    </pageFooter>
</jasperReport>
