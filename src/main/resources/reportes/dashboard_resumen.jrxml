<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="dashboard_resumen" pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="782" leftMargin="30" rightMargin="30" topMargin="24" bottomMargin="24">

    <parameter name="TITULO_SISTEMA" class="java.lang.String"/>
    <parameter name="GENERADO_POR" class="java.lang.String"/>
    <parameter name="INSTANTE_GENERACION" class="java.lang.String"/>
    <parameter name="PROPIEDADES_ACTIVAS" class="java.lang.Integer"/>
    <parameter name="UNIDADES_TOTAL" class="java.lang.Integer"/>
    <parameter name="INQUILINOS_ACTIVOS" class="java.lang.Integer"/>
    <parameter name="CONTRATOS_VIGENTES" class="java.lang.Integer"/>

    <field name="indicador" class="java.lang.String"/>
    <field name="moneda" class="java.lang.String"/>
    <field name="cantidad" class="java.lang.Long"/>
    <field name="total" class="java.lang.String"/>

    <title height="94">
        <element kind="rectangle" x="0" y="0" width="782" height="42" backcolor="#0F172A">
            <pen lineWidth="0.0"/>
        </element>
        <element kind="textField" x="14" y="6" width="490" height="30" forecolor="#FFFFFF" vTextAlign="Middle" fontSize="15.0" bold="true">
            <expression><![CDATA[$P{TITULO_SISTEMA} == null ? "LATCH — Resumen Ejecutivo del Panel" : $P{TITULO_SISTEMA}]]></expression>
        </element>
        <element kind="textField" x="510" y="10" width="258" height="22" forecolor="#E2E8F0" hTextAlign="Right" vTextAlign="Middle" fontSize="9.0" bold="true">
            <expression><![CDATA["Generado: " + ($P{INSTANTE_GENERACION} == null ? "—" : $P{INSTANTE_GENERACION})]]></expression>
        </element>

        <element kind="rectangle" x="0" y="48" width="782" height="24" backcolor="#F1F5F9">
            <pen lineWidth="0.5" lineColor="#E2E8F0"/>
        </element>
        <element kind="textField" x="10" y="50" width="762" height="20" forecolor="#0F172A" vTextAlign="Middle" fontSize="9.0" bold="true">
            <expression><![CDATA["Propiedades activas: " + ($P{PROPIEDADES_ACTIVAS} == null ? 0 : $P{PROPIEDADES_ACTIVAS}) + "   |   Unidades: " + ($P{UNIDADES_TOTAL} == null ? 0 : $P{UNIDADES_TOTAL}) + "   |   Inquilinos activos: " + ($P{INQUILINOS_ACTIVOS} == null ? 0 : $P{INQUILINOS_ACTIVOS}) + "   |   Contratos vigentes: " + ($P{CONTRATOS_VIGENTES} == null ? 0 : $P{CONTRATOS_VIGENTES})]]></expression>
        </element>

        <element kind="textField" x="0" y="74" width="782" height="16" forecolor="#475569" vTextAlign="Middle" fontSize="8.5">
            <expression><![CDATA["Generado por: " + ($P{GENERADO_POR} == null || $P{GENERADO_POR}.isBlank() ? "Sistema" : $P{GENERADO_POR}) + " · Instante: " + ($P{INSTANTE_GENERACION} == null ? "—" : $P{INSTANTE_GENERACION})]]></expression>
        </element>
    </title>

    <columnHeader height="26">
        <element kind="rectangle" x="0" y="0" width="782" height="24" backcolor="#E2E8F0">
            <pen lineWidth="0.0"/>
        </element>
        <element kind="staticText" x="10" y="0" width="350" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="9.0" bold="true">
            <text><![CDATA[Indicador financiero]]></text>
        </element>
        <element kind="staticText" x="360" y="0" width="100" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="9.0" bold="true">
            <text><![CDATA[Moneda]]></text>
        </element>
        <element kind="staticText" x="460" y="0" width="120" height="24" forecolor="#0F172A" hTextAlign="Right" vTextAlign="Middle" fontSize="9.0" bold="true">
            <text><![CDATA[Registros]]></text>
        </element>
        <element kind="staticText" x="580" y="0" width="192" height="24" forecolor="#0F172A" hTextAlign="Right" vTextAlign="Middle" fontSize="9.0" bold="true">
            <text><![CDATA[Total en moneda]]></text>
        </element>
    </columnHeader>

    <detail>
        <band height="24">
            <element kind="textField" x="10" y="2" width="350" height="18" forecolor="#1E293B" vTextAlign="Middle" fontSize="9.0">
                <expression><![CDATA[$F{indicador} == null || $F{indicador}.isBlank() ? "—" : $F{indicador}]]></expression>
            </element>
            <element kind="textField" x="360" y="2" width="100" height="18" forecolor="#0F172A" vTextAlign="Middle" fontSize="9.0" bold="true">
                <expression><![CDATA[$F{moneda} == null || $F{moneda}.isBlank() ? "—" : $F{moneda}]]></expression>
            </element>
            <element kind="textField" x="460" y="2" width="120" height="18" forecolor="#334155" hTextAlign="Right" vTextAlign="Middle" fontSize="9.0">
                <expression><![CDATA[$F{cantidad} == null ? "0" : $F{cantidad}.toString()]]></expression>
            </element>
            <element kind="textField" x="580" y="2" width="192" height="18" forecolor="#0F172A" hTextAlign="Right" vTextAlign="Middle" fontSize="9.0" bold="true">
                <expression><![CDATA[$F{total} == null || $F{total}.isBlank() ? "0.00" : $F{total}]]></expression>
            </element>
            <element kind="line" x="0" y="22" width="782" height="1" forecolor="#E2E8F0">
                <pen lineWidth="0.5"/>
            </element>
        </band>
    </detail>

    <pageFooter height="22">
        <element kind="textField" x="0" y="2" width="660" height="18" forecolor="#64748B" vTextAlign="Middle" fontSize="8.5">
            <expression><![CDATA["Latch · Documento generado automáticamente"]]></expression>
        </element>
        <element kind="textField" x="660" y="2" width="90" height="18" forecolor="#64748B" hTextAlign="Right" vTextAlign="Middle" fontSize="8.5">
            <expression><![CDATA["Página " + $V{PAGE_NUMBER} + " de "]]></expression>
        </element>
        <element kind="textField" x="750" y="2" width="32" height="18" forecolor="#64748B" vTextAlign="Middle" fontSize="8.5" evaluationTime="Report">
            <expression><![CDATA[$V{PAGE_NUMBER}]]></expression>
        </element>
    </pageFooter>
</jasperReport>
