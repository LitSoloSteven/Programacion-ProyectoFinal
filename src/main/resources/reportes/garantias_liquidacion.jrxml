<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="garantias_liquidacion" pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="782" leftMargin="30" rightMargin="30" topMargin="24" bottomMargin="24"
              whenNoDataType="AllSectionsNoDetail">

    <parameter name="TITULO_SISTEMA" class="java.lang.String"/>
    <parameter name="GENERADO_POR" class="java.lang.String"/>
    <parameter name="FECHA_CORTE" class="java.lang.String"/>
    <parameter name="FILTROS_TEXTO" class="java.lang.String"/>
    <parameter name="RESUMEN_USD" class="java.lang.String"/>
    <parameter name="RESUMEN_NIO" class="java.lang.String"/>

    <field name="contrato" class="java.lang.String"/>
    <field name="fecha" class="java.lang.String"/>
    <field name="tipoRegistro" class="java.lang.String"/>
    <field name="concepto" class="java.lang.String"/>
    <field name="metodo" class="java.lang.String"/>
    <field name="moneda" class="java.lang.String"/>
    <field name="inicial" class="java.math.BigDecimal"/>
    <field name="salida" class="java.math.BigDecimal"/>
    <field name="remanente" class="java.math.BigDecimal"/>

    <title height="114">
        <element kind="rectangle" x="0" y="0" width="782" height="40" backcolor="#0F172A">
            <pen lineWidth="0.0"/>
        </element>
        <element kind="textField" x="14" y="5" width="520" height="30" forecolor="#FFFFFF" vTextAlign="Middle" fontSize="15.0" bold="true">
            <expression><![CDATA[$P{TITULO_SISTEMA} == null ? "LATCH — Liquidación de Depósitos de Garantía" : $P{TITULO_SISTEMA}]]></expression>
        </element>
        <element kind="textField" x="540" y="8" width="228" height="24" forecolor="#CBD5E1" hTextAlign="Right" vTextAlign="Middle" fontSize="9.0" bold="true">
            <expression><![CDATA["Corte: " + ($P{FECHA_CORTE} == null ? "—" : $P{FECHA_CORTE})]]></expression>
        </element>
        <element kind="textField" x="0" y="44" width="782" height="16" forecolor="#475569" vTextAlign="Middle" fontSize="8.5">
            <expression><![CDATA["Generado por: " + ($P{GENERADO_POR} == null ? "Sistema" : $P{GENERADO_POR}) + " · " + ($P{FILTROS_TEXTO} == null ? "" : $P{FILTROS_TEXTO})]]></expression>
        </element>
        <element kind="rectangle" x="0" y="64" width="782" height="44" backcolor="#F1F5F9">
            <pen lineWidth="0.5" lineColor="#E2E8F0"/>
        </element>
        <element kind="textField" x="8" y="67" width="766" height="18" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.0" bold="true">
            <expression><![CDATA[$P{RESUMEN_USD} == null ? "USD: 0.00" : $P{RESUMEN_USD}]]></expression>
        </element>
        <element kind="textField" x="8" y="86" width="766" height="18" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.0" bold="true">
            <expression><![CDATA[$P{RESUMEN_NIO} == null ? "NIO: 0.00" : $P{RESUMEN_NIO}]]></expression>
        </element>
    </title>

    <columnHeader height="26">
        <element kind="rectangle" x="0" y="0" width="782" height="24" backcolor="#E2E8F0">
            <pen lineWidth="0.0"/>
        </element>
        <element kind="staticText" x="4" y="0" width="152" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.0" bold="true">
            <text><![CDATA[Contrato / Inquilino]]></text>
        </element>
        <element kind="staticText" x="156" y="0" width="68" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.0" bold="true">
            <text><![CDATA[Fecha]]></text>
        </element>
        <element kind="staticText" x="224" y="0" width="82" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.0" bold="true">
            <text><![CDATA[Movimiento]]></text>
        </element>
        <element kind="staticText" x="306" y="0" width="174" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.0" bold="true">
            <text><![CDATA[Concepto]]></text>
        </element>
        <element kind="staticText" x="480" y="0" width="66" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.0" bold="true">
            <text><![CDATA[Método]]></text>
        </element>
        <element kind="staticText" x="546" y="0" width="36" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.0" bold="true">
            <text><![CDATA[Mon.]]></text>
        </element>
        <element kind="staticText" x="582" y="0" width="66" height="24" forecolor="#0F172A" hTextAlign="Right" vTextAlign="Middle" fontSize="8.0" bold="true">
            <text><![CDATA[Inicial]]></text>
        </element>
        <element kind="staticText" x="648" y="0" width="66" height="24" forecolor="#0F172A" hTextAlign="Right" vTextAlign="Middle" fontSize="8.0" bold="true">
            <text><![CDATA[Salida]]></text>
        </element>
        <element kind="staticText" x="714" y="0" width="68" height="24" forecolor="#0F172A" hTextAlign="Right" vTextAlign="Middle" fontSize="8.0" bold="true">
            <text><![CDATA[Remanente]]></text>
        </element>
    </columnHeader>

    <detail>
        <band height="24">
            <element kind="textField" x="4" y="2" width="152" height="18" forecolor="#1E293B" vTextAlign="Middle" fontSize="8.0" textAdjust="StretchHeight">
                <expression><![CDATA[$F{contrato} == null ? "—" : $F{contrato}]]></expression>
            </element>
            <element kind="textField" x="156" y="2" width="68" height="18" forecolor="#334155" vTextAlign="Middle" fontSize="8.0">
                <expression><![CDATA[$F{fecha} == null ? "—" : $F{fecha}]]></expression>
            </element>
            <element kind="textField" x="224" y="2" width="82" height="18" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.0" bold="true">
                <expression><![CDATA[$F{tipoRegistro} == null ? "—" : $F{tipoRegistro}]]></expression>
            </element>
            <element kind="textField" x="306" y="2" width="174" height="18" forecolor="#334155" vTextAlign="Middle" fontSize="8.0" textAdjust="StretchHeight">
                <expression><![CDATA[$F{concepto} == null ? "—" : $F{concepto}]]></expression>
            </element>
            <element kind="textField" x="480" y="2" width="66" height="18" forecolor="#334155" vTextAlign="Middle" fontSize="8.0">
                <expression><![CDATA[$F{metodo} == null ? "—" : $F{metodo}]]></expression>
            </element>
            <element kind="textField" x="546" y="2" width="36" height="18" forecolor="#334155" vTextAlign="Middle" fontSize="8.0">
                <expression><![CDATA[$F{moneda} == null ? "—" : $F{moneda}]]></expression>
            </element>
            <element kind="textField" x="582" y="2" width="66" height="18" forecolor="#0F172A" hTextAlign="Right" vTextAlign="Middle" fontSize="8.0" pattern="#,##0.00">
                <expression><![CDATA[$F{inicial}]]></expression>
            </element>
            <element kind="textField" x="648" y="2" width="66" height="18" forecolor="#0F172A" hTextAlign="Right" vTextAlign="Middle" fontSize="8.0" pattern="#,##0.00">
                <expression><![CDATA[$F{salida}]]></expression>
            </element>
            <element kind="textField" x="714" y="2" width="68" height="18" forecolor="#0F172A" hTextAlign="Right" vTextAlign="Middle" fontSize="8.0" pattern="#,##0.00" bold="true">
                <expression><![CDATA[$F{remanente}]]></expression>
            </element>
            <element kind="line" x="0" y="22" width="782" height="1" forecolor="#E2E8F0">
                <pen lineWidth="0.5"/>
            </element>
        </band>
    </detail>

    <pageFooter height="22">
        <element kind="textField" x="0" y="2" width="660" height="18" forecolor="#64748B" vTextAlign="Middle" fontSize="8.5">
            <expression><![CDATA["Latch · Movimientos de garantía conciliables (Inicial - Aplicado - Deducido - Devuelto = Remanente)"]]></expression>
        </element>
        <element kind="textField" x="660" y="2" width="90" height="18" forecolor="#64748B" hTextAlign="Right" vTextAlign="Middle" fontSize="8.5">
            <expression><![CDATA["Página " + $V{PAGE_NUMBER} + " de "]]></expression>
        </element>
        <element kind="textField" x="750" y="2" width="32" height="18" forecolor="#64748B" vTextAlign="Middle" fontSize="8.5" evaluationTime="Report">
            <expression><![CDATA[$V{PAGE_NUMBER}]]></expression>
        </element>
    </pageFooter>
</jasperReport>
