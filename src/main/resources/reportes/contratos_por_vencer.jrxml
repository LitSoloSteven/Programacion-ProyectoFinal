<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="contratos_por_vencer" pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="782" leftMargin="30" rightMargin="30" topMargin="24" bottomMargin="24"
              whenNoDataType="AllSectionsNoDetail">

    <parameter name="TITULO_SISTEMA" class="java.lang.String"/>
    <parameter name="GENERADO_POR" class="java.lang.String"/>
    <parameter name="FECHA_BASE" class="java.lang.String"/>
    <parameter name="UMBRAL_DIAS" class="java.lang.Integer"/>
    <parameter name="FILTROS_TEXTO" class="java.lang.String"/>
    <parameter name="RESUMEN_TOTALES" class="java.lang.String"/>

    <field name="inquilino" class="java.lang.String"/>
    <field name="propiedad" class="java.lang.String"/>
    <field name="unidad" class="java.lang.String"/>
    <field name="estado" class="java.lang.String"/>
    <field name="inicio" class="java.lang.String"/>
    <field name="fin" class="java.lang.String"/>
    <field name="diasRestantes" class="java.lang.Long"/>
    <field name="moneda" class="java.lang.String"/>
    <field name="canon" class="java.math.BigDecimal"/>

    <title height="96">
        <element kind="rectangle" x="0" y="0" width="782" height="40" backcolor="#0F172A">
            <pen lineWidth="0.0"/>
        </element>
        <element kind="textField" x="14" y="5" width="510" height="30" forecolor="#FFFFFF" vTextAlign="Middle" fontSize="15.0" bold="true">
            <expression><![CDATA[$P{TITULO_SISTEMA} == null ? "LATCH — Contratos por Vencer" : $P{TITULO_SISTEMA}]]></expression>
        </element>
        <element kind="textField" x="530" y="8" width="238" height="24" forecolor="#CBD5E1" hTextAlign="Right" vTextAlign="Middle" fontSize="9.0" bold="true">
            <expression><![CDATA["Base: " + ($P{FECHA_BASE} == null ? "—" : $P{FECHA_BASE}) + " · Umbral: " + ($P{UMBRAL_DIAS} == null ? 30 : $P{UMBRAL_DIAS}) + " días"]]></expression>
        </element>
        <element kind="textField" x="0" y="44" width="782" height="16" forecolor="#475569" vTextAlign="Middle" fontSize="8.5">
            <expression><![CDATA["Generado por: " + ($P{GENERADO_POR} == null ? "Sistema" : $P{GENERADO_POR}) + " · " + ($P{FILTROS_TEXTO} == null ? "" : $P{FILTROS_TEXTO})]]></expression>
        </element>
        <element kind="rectangle" x="0" y="64" width="782" height="24" backcolor="#F1F5F9">
            <pen lineWidth="0.5" lineColor="#E2E8F0"/>
        </element>
        <element kind="textField" x="8" y="66" width="766" height="20" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.5" bold="true">
            <expression><![CDATA[$P{RESUMEN_TOTALES} == null ? "Contratos: 0" : $P{RESUMEN_TOTALES}]]></expression>
        </element>
    </title>

    <columnHeader height="26">
        <element kind="rectangle" x="0" y="0" width="782" height="24" backcolor="#E2E8F0">
            <pen lineWidth="0.0"/>
        </element>
        <element kind="staticText" x="6" y="0" width="152" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.5" bold="true">
            <text><![CDATA[Inquilino]]></text>
        </element>
        <element kind="staticText" x="158" y="0" width="136" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.5" bold="true">
            <text><![CDATA[Propiedad]]></text>
        </element>
        <element kind="staticText" x="294" y="0" width="84" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.5" bold="true">
            <text><![CDATA[Unidad]]></text>
        </element>
        <element kind="staticText" x="378" y="0" width="76" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.5" bold="true">
            <text><![CDATA[Estado]]></text>
        </element>
        <element kind="staticText" x="454" y="0" width="74" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.5" bold="true">
            <text><![CDATA[Inicio]]></text>
        </element>
        <element kind="staticText" x="528" y="0" width="74" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.5" bold="true">
            <text><![CDATA[Vence]]></text>
        </element>
        <element kind="staticText" x="602" y="0" width="52" height="24" forecolor="#0F172A" hTextAlign="Right" vTextAlign="Middle" fontSize="8.5" bold="true">
            <text><![CDATA[Días]]></text>
        </element>
        <element kind="staticText" x="658" y="0" width="38" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.5" bold="true">
            <text><![CDATA[Mon.]]></text>
        </element>
        <element kind="staticText" x="696" y="0" width="80" height="24" forecolor="#0F172A" hTextAlign="Right" vTextAlign="Middle" fontSize="8.5" bold="true">
            <text><![CDATA[Canon]]></text>
        </element>
    </columnHeader>

    <detail>
        <band height="24">
            <element kind="textField" x="6" y="2" width="152" height="18" forecolor="#1E293B" vTextAlign="Middle" fontSize="8.5" textAdjust="StretchHeight">
                <expression><![CDATA[$F{inquilino} == null ? "—" : $F{inquilino}]]></expression>
            </element>
            <element kind="textField" x="158" y="2" width="136" height="18" forecolor="#334155" vTextAlign="Middle" fontSize="8.5" textAdjust="StretchHeight">
                <expression><![CDATA[$F{propiedad} == null ? "—" : $F{propiedad}]]></expression>
            </element>
            <element kind="textField" x="294" y="2" width="84" height="18" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.5" bold="true">
                <expression><![CDATA[$F{unidad} == null ? "—" : $F{unidad}]]></expression>
            </element>
            <element kind="textField" x="378" y="2" width="76" height="18" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.5" bold="true">
                <expression><![CDATA[$F{estado} == null ? "—" : $F{estado}]]></expression>
            </element>
            <element kind="textField" x="454" y="2" width="74" height="18" forecolor="#334155" vTextAlign="Middle" fontSize="8.5">
                <expression><![CDATA[$F{inicio} == null ? "—" : $F{inicio}]]></expression>
            </element>
            <element kind="textField" x="528" y="2" width="74" height="18" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.5" bold="true">
                <expression><![CDATA[$F{fin} == null ? "—" : $F{fin}]]></expression>
            </element>
            <element kind="textField" x="602" y="2" width="52" height="18" forecolor="#0F172A" hTextAlign="Right" vTextAlign="Middle" fontSize="8.5" bold="true">
                <expression><![CDATA[$F{diasRestantes} == null ? 0L : $F{diasRestantes}]]></expression>
            </element>
            <element kind="textField" x="658" y="2" width="38" height="18" forecolor="#334155" vTextAlign="Middle" fontSize="8.5">
                <expression><![CDATA[$F{moneda} == null ? "—" : $F{moneda}]]></expression>
            </element>
            <element kind="textField" x="696" y="2" width="80" height="18" forecolor="#0F172A" hTextAlign="Right" vTextAlign="Middle" fontSize="8.5" pattern="#,##0.00">
                <expression><![CDATA[$F{canon}]]></expression>
            </element>
            <element kind="line" x="0" y="22" width="782" height="1" forecolor="#E2E8F0">
                <pen lineWidth="0.5"/>
            </element>
        </band>
    </detail>

    <pageFooter height="22">
        <element kind="textField" x="0" y="2" width="660" height="18" forecolor="#64748B" vTextAlign="Middle" fontSize="8.5">
            <expression><![CDATA["Latch · Excluye contratos Terminado, Cancelado y Borrador"]]></expression>
        </element>
        <element kind="textField" x="660" y="2" width="90" height="18" forecolor="#64748B" hTextAlign="Right" vTextAlign="Middle" fontSize="8.5">
            <expression><![CDATA["Página " + $V{PAGE_NUMBER} + " de "]]></expression>
        </element>
        <element kind="textField" x="750" y="2" width="32" height="18" forecolor="#64748B" vTextAlign="Middle" fontSize="8.5" evaluationTime="Report">
            <expression><![CDATA[$V{PAGE_NUMBER}]]></expression>
        </element>
    </pageFooter>
</jasperReport>
