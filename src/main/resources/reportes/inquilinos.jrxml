<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="inquilinos" pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="782" leftMargin="30" rightMargin="30" topMargin="24" bottomMargin="24">

    <parameter name="TITULO_SISTEMA" class="java.lang.String"/>
    <parameter name="GENERADO_POR" class="java.lang.String"/>
    <parameter name="TOTAL_INQUILINOS" class="java.lang.Integer"/>
    <parameter name="INQUILINOS_ACTIVOS" class="java.lang.Integer"/>
    <parameter name="INQUILINOS_INACTIVOS" class="java.lang.Integer"/>

    <field name="nombre" class="java.lang.String"/>
    <field name="identificacion" class="java.lang.String"/>
    <field name="telefono" class="java.lang.String"/>
    <field name="correo" class="java.lang.String"/>
    <field name="contactoEmergencia" class="java.lang.String"/>
    <field name="estado" class="java.lang.String"/>

    <title height="86">
        <element kind="rectangle" x="0" y="0" width="782" height="42" backcolor="#0F172A">
            <pen lineWidth="0.0"/>
        </element>
        <element kind="textField" x="14" y="6" width="510" height="30" forecolor="#FFFFFF" vTextAlign="Middle" fontSize="15.0" bold="true">
            <expression><![CDATA[$P{TITULO_SISTEMA} == null ? "LATCH — Directorio de Inquilinos" : $P{TITULO_SISTEMA}]]></expression>
        </element>
        <element kind="textField" x="528" y="8" width="240" height="26" forecolor="#CBD5E1" hTextAlign="Right" vTextAlign="Middle" fontSize="9.0">
            <expression><![CDATA["Total: " + ($P{TOTAL_INQUILINOS} == null ? 0 : $P{TOTAL_INQUILINOS}) + " · Activos: " + ($P{INQUILINOS_ACTIVOS} == null ? 0 : $P{INQUILINOS_ACTIVOS})]]></expression>
        </element>
        <element kind="textField" x="0" y="46" width="782" height="16" forecolor="#475569" vTextAlign="Middle" fontSize="9.0">
            <expression><![CDATA["Generado por: " + ($P{GENERADO_POR} == null || $P{GENERADO_POR}.isBlank() ? "Sistema" : $P{GENERADO_POR})]]></expression>
        </element>
        <element kind="rectangle" x="0" y="64" width="782" height="18" backcolor="#F1F5F9">
            <pen lineWidth="0.0"/>
        </element>
        <element kind="textField" x="10" y="64" width="762" height="18" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.5" bold="true">
            <expression><![CDATA["Inquilinos activos: " + ($P{INQUILINOS_ACTIVOS} == null ? 0 : $P{INQUILINOS_ACTIVOS}) + "   |   Inquilinos inactivos: " + ($P{INQUILINOS_INACTIVOS} == null ? 0 : $P{INQUILINOS_INACTIVOS})]]></expression>
        </element>
    </title>

    <columnHeader height="26">
        <element kind="rectangle" x="0" y="0" width="782" height="24" backcolor="#E2E8F0">
            <pen lineWidth="0.0"/>
        </element>
        <element kind="staticText" x="6" y="0" width="175" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.5" bold="true">
            <text><![CDATA[Nombre]]></text>
        </element>
        <element kind="staticText" x="181" y="0" width="110" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.5" bold="true">
            <text><![CDATA[Identificación]]></text>
        </element>
        <element kind="staticText" x="291" y="0" width="95" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.5" bold="true">
            <text><![CDATA[Teléfono]]></text>
        </element>
        <element kind="staticText" x="386" y="0" width="155" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.5" bold="true">
            <text><![CDATA[Correo]]></text>
        </element>
        <element kind="staticText" x="541" y="0" width="166" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.5" bold="true">
            <text><![CDATA[Contacto emergencia]]></text>
        </element>
        <element kind="staticText" x="707" y="0" width="75" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.5" bold="true">
            <text><![CDATA[Estado]]></text>
        </element>
    </columnHeader>

    <detail>
        <band height="24">
            <element kind="textField" x="6" y="2" width="175" height="18" forecolor="#1E293B" vTextAlign="Middle" fontSize="8.5" textAdjust="StretchHeight">
                <expression><![CDATA[$F{nombre} == null || $F{nombre}.isBlank() ? "—" : $F{nombre}]]></expression>
            </element>
            <element kind="textField" x="181" y="2" width="110" height="18" forecolor="#334155" vTextAlign="Middle" fontSize="8.5">
                <expression><![CDATA[$F{identificacion} == null || $F{identificacion}.isBlank() ? "—" : $F{identificacion}]]></expression>
            </element>
            <element kind="textField" x="291" y="2" width="95" height="18" forecolor="#334155" vTextAlign="Middle" fontSize="8.5">
                <expression><![CDATA[$F{telefono} == null || $F{telefono}.isBlank() ? "—" : $F{telefono}]]></expression>
            </element>
            <element kind="textField" x="386" y="2" width="155" height="18" forecolor="#334155" vTextAlign="Middle" fontSize="8.5" textAdjust="StretchHeight">
                <expression><![CDATA[$F{correo} == null || $F{correo}.isBlank() ? "—" : $F{correo}]]></expression>
            </element>
            <element kind="textField" x="541" y="2" width="166" height="18" forecolor="#334155" vTextAlign="Middle" fontSize="8.5" textAdjust="StretchHeight">
                <expression><![CDATA[$F{contactoEmergencia} == null || $F{contactoEmergencia}.isBlank() ? "—" : $F{contactoEmergencia}]]></expression>
            </element>
            <element kind="textField" x="707" y="2" width="75" height="18" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.5" bold="true">
                <expression><![CDATA[$F{estado} == null || $F{estado}.isBlank() ? "—" : $F{estado}]]></expression>
            </element>
            <element kind="line" x="0" y="22" width="782" height="1" forecolor="#E2E8F0">
                <pen lineWidth="0.5"/>
            </element>
        </band>
    </detail>

    <pageFooter height="22">
        <element kind="textField" x="0" y="2" width="660" height="18" forecolor="#64748B" vTextAlign="Middle" fontSize="8.5">
            <expression><![CDATA["Latch · Documento generado automáticamente"]]></expression>
        </element>
        <element kind="textField" x="660" y="2" width="90" height="18" forecolor="#64748B" hTextAlign="Right" vTextAlign="Middle" fontSize="8.5">
            <expression><![CDATA["Página " + $V{PAGE_NUMBER} + " de "]]></expression>
        </element>
        <element kind="textField" x="750" y="2" width="32" height="18" forecolor="#64748B" vTextAlign="Middle" fontSize="8.5" evaluationTime="Report">
            <expression><![CDATA[$V{PAGE_NUMBER}]]></expression>
        </element>
    </pageFooter>
</jasperReport>