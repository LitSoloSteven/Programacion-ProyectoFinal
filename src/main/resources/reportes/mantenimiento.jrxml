<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="mantenimiento" pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="782" leftMargin="30" rightMargin="30" topMargin="24" bottomMargin="24"
              whenNoDataType="AllSectionsNoDetail">

    <parameter name="TITULO_SISTEMA" class="java.lang.String"/>
    <parameter name="GENERADO_POR" class="java.lang.String"/>
    <parameter name="FILTROS_TEXTO" class="java.lang.String"/>
    <parameter name="CONTEO_SOLICITUDES" class="java.lang.String"/>
    <parameter name="TOTAL_COSTO_USD" class="java.lang.String"/>
    <parameter name="TOTAL_COSTO_NIO" class="java.lang.String"/>

    <field name="claseRegistro" class="java.lang.String"/>
    <field name="propiedad" class="java.lang.String"/>
    <field name="unidad" class="java.lang.String"/>
    <field name="fecha" class="java.lang.String"/>
    <field name="prioridad" class="java.lang.String"/>
    <field name="estado" class="java.lang.String"/>
    <field name="responsable" class="java.lang.String"/>
    <field name="detalle" class="java.lang.String"/>
    <field name="costoUsd" class="java.math.BigDecimal"/>
    <field name="costoNio" class="java.math.BigDecimal"/>

    <title height="106">
        <element kind="rectangle" x="0" y="0" width="782" height="40" backcolor="#0F172A">
            <pen lineWidth="0.0"/>
        </element>
        <element kind="textField" x="14" y="5" width="510" height="30" forecolor="#FFFFFF" vTextAlign="Middle" fontSize="15.0" bold="true">
            <expression><![CDATA[$P{TITULO_SISTEMA} == null ? "LATCH — Reporte de Mantenimiento y Gastos" : $P{TITULO_SISTEMA}]]></expression>
        </element>
        <element kind="textField" x="530" y="8" width="238" height="24" forecolor="#CBD5E1" hTextAlign="Right" vTextAlign="Middle" fontSize="8.5" bold="true">
            <expression><![CDATA[$P{CONTEO_SOLICITUDES} == null ? "" : $P{CONTEO_SOLICITUDES}]]></expression>
        </element>
        <element kind="textField" x="0" y="44" width="782" height="16" forecolor="#475569" vTextAlign="Middle" fontSize="8.5">
            <expression><![CDATA["Generado por: " + ($P{GENERADO_POR} == null ? "Sistema" : $P{GENERADO_POR}) + " · " + ($P{FILTROS_TEXTO} == null ? "" : $P{FILTROS_TEXTO})]]></expression>
        </element>
        <element kind="rectangle" x="0" y="64" width="782" height="34" backcolor="#F1F5F9">
            <pen lineWidth="0.5" lineColor="#E2E8F0"/>
        </element>
        <element kind="textField" x="8" y="68" width="766" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.5" bold="true">
            <expression><![CDATA["Costo total USD: " + ($P{TOTAL_COSTO_USD} == null ? "0.00" : $P{TOTAL_COSTO_USD}) + " USD   |   Costo total NIO: " + ($P{TOTAL_COSTO_NIO} == null ? "0.00" : $P{TOTAL_COSTO_NIO}) + " NIO"]]></expression>
        </element>
    </title>

    <columnHeader height="26">
        <element kind="rectangle" x="0" y="0" width="782" height="24" backcolor="#E2E8F0">
            <pen lineWidth="0.0"/>
        </element>
        <element kind="staticText" x="4" y="0" width="58" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.0" bold="true">
            <text><![CDATA[Tipo]]></text>
        </element>
        <element kind="staticText" x="62" y="0" width="110" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.0" bold="true">
            <text><![CDATA[Propiedad]]></text>
        </element>
        <element kind="staticText" x="172" y="0" width="60" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.0" bold="true">
            <text><![CDATA[Unidad]]></text>
        </element>
        <element kind="staticText" x="232" y="0" width="62" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.0" bold="true">
            <text><![CDATA[Fecha]]></text>
        </element>
        <element kind="staticText" x="294" y="0" width="52" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.0" bold="true">
            <text><![CDATA[Prior.]]></text>
        </element>
        <element kind="staticText" x="346" y="0" width="68" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.0" bold="true">
            <text><![CDATA[Estado]]></text>
        </element>
        <element kind="staticText" x="414" y="0" width="84" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.0" bold="true">
            <text><![CDATA[Responsable]]></text>
        </element>
        <element kind="staticText" x="498" y="0" width="144" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.0" bold="true">
            <text><![CDATA[Descripción / Concepto]]></text>
        </element>
        <element kind="staticText" x="642" y="0" width="70" height="24" forecolor="#0F172A" hTextAlign="Right" vTextAlign="Middle" fontSize="8.0" bold="true">
            <text><![CDATA[Costo USD]]></text>
        </element>
        <element kind="staticText" x="712" y="0" width="70" height="24" forecolor="#0F172A" hTextAlign="Right" vTextAlign="Middle" fontSize="8.0" bold="true">
            <text><![CDATA[Costo NIO]]></text>
        </element>
    </columnHeader>

    <detail>
        <band height="24">
            <element kind="textField" x="4" y="2" width="58" height="18" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.0" bold="true">
                <expression><![CDATA[$F{claseRegistro} == null ? "—" : $F{claseRegistro}]]></expression>
            </element>
            <element kind="textField" x="62" y="2" width="110" height="18" forecolor="#1E293B" vTextAlign="Middle" fontSize="8.0" textAdjust="StretchHeight">
                <expression><![CDATA[$F{propiedad} == null ? "—" : $F{propiedad}]]></expression>
            </element>
            <element kind="textField" x="172" y="2" width="60" height="18" forecolor="#334155" vTextAlign="Middle" fontSize="8.0">
                <expression><![CDATA[$F{unidad} == null ? "—" : $F{unidad}]]></expression>
            </element>
            <element kind="textField" x="232" y="2" width="62" height="18" forecolor="#334155" vTextAlign="Middle" fontSize="8.0">
                <expression><![CDATA[$F{fecha} == null ? "—" : $F{fecha}]]></expression>
            </element>
            <element kind="textField" x="294" y="2" width="52" height="18" forecolor="#334155" vTextAlign="Middle" fontSize="8.0">
                <expression><![CDATA[$F{prioridad} == null ? "—" : $F{prioridad}]]></expression>
            </element>
            <element kind="textField" x="346" y="2" width="68" height="18" forecolor="#0F172A" vTextAlign="Middle" fontSize="8.0" bold="true">
                <expression><![CDATA[$F{estado} == null ? "—" : $F{estado}]]></expression>
            </element>
            <element kind="textField" x="414" y="2" width="84" height="18" forecolor="#334155" vTextAlign="Middle" fontSize="8.0" textAdjust="StretchHeight">
                <expression><![CDATA[$F{responsable} == null ? "—" : $F{responsable}]]></expression>
            </element>
            <element kind="textField" x="498" y="2" width="144" height="18" forecolor="#1E293B" vTextAlign="Middle" fontSize="8.0" textAdjust="StretchHeight">
                <expression><![CDATA[$F{detalle} == null ? "—" : $F{detalle}]]></expression>
            </element>
            <element kind="textField" x="642" y="2" width="70" height="18" forecolor="#0F172A" hTextAlign="Right" vTextAlign="Middle" fontSize="8.0" pattern="#,##0.00">
                <expression><![CDATA[$F{costoUsd}]]></expression>
            </element>
            <element kind="textField" x="712" y="2" width="70" height="18" forecolor="#0F172A" hTextAlign="Right" vTextAlign="Middle" fontSize="8.0" pattern="#,##0.00">
                <expression><![CDATA[$F{costoNio}]]></expression>
            </element>
            <element kind="line" x="0" y="22" width="782" height="1" forecolor="#E2E8F0">
                <pen lineWidth="0.5"/>
            </element>
        </band>
    </detail>

    <pageFooter height="22">
        <element kind="textField" x="0" y="2" width="660" height="18" forecolor="#64748B" vTextAlign="Middle" fontSize="8.5">
            <expression><![CDATA["Latch · Gastos de mantenimiento a cargo del propietario (sin cargo automático al inquilino)"]]></expression>
        </element>
        <element kind="textField" x="660" y="2" width="90" height="18" forecolor="#64748B" hTextAlign="Right" vTextAlign="Middle" fontSize="8.5">
            <expression><![CDATA["Página " + $V{PAGE_NUMBER} + " de "]]></expression>
        </element>
        <element kind="textField" x="750" y="2" width="32" height="18" forecolor="#64748B" vTextAlign="Middle" fontSize="8.5" evaluationTime="Report">
            <expression><![CDATA[$V{PAGE_NUMBER}]]></expression>
        </element>
    </pageFooter>
</jasperReport>
