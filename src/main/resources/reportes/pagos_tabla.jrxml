<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="pagos_tabla" pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="782" leftMargin="30" rightMargin="30" topMargin="24" bottomMargin="24">

    <parameter name="TITULO_SISTEMA" class="java.lang.String"/>
    <parameter name="GENERADO_POR" class="java.lang.String"/>
    <parameter name="TOTAL_REGISTROS" class="java.lang.Integer"/>

    <field name="contrato" class="java.lang.String"/>
    <field name="fechaPago" class="java.time.LocalDate"/>
    <field name="montoOriginal" class="java.math.BigDecimal"/>
    <field name="monedaOriginal" class="java.lang.String"/>
    <field name="montoContrato" class="java.math.BigDecimal"/>
    <field name="monedaContrato" class="java.lang.String"/>
    <field name="metodo" class="java.lang.String"/>
    <field name="referencia" class="java.lang.String"/>
    <field name="estado" class="java.lang.String"/>

    <title height="68">
        <element kind="rectangle" x="0" y="0" width="782" height="42" backcolor="#0F172A">
            <pen lineWidth="0.0"/>
        </element>
        <element kind="textField" x="14" y="6" width="540" height="30" forecolor="#FFFFFF" vTextAlign="Middle" fontSize="15.0" bold="true">
            <expression><![CDATA[$P{TITULO_SISTEMA} == null ? "LATCH — Reporte de Pagos" : $P{TITULO_SISTEMA}]]></expression>
        </element>
        <element kind="textField" x="560" y="10" width="208" height="22" forecolor="#CBD5E1" hTextAlign="Right" vTextAlign="Middle" fontSize="9.5">
            <expression><![CDATA["Registros: " + ($P{TOTAL_REGISTROS} == null ? 0 : $P{TOTAL_REGISTROS})]]></expression>
        </element>
        <element kind="textField" x="0" y="46" width="782" height="18" forecolor="#475569" vTextAlign="Middle" fontSize="9.0">
            <expression><![CDATA["Generado por: " + ($P{GENERADO_POR} == null || $P{GENERADO_POR}.isBlank() ? "Sistema" : $P{GENERADO_POR})]]></expression>
        </element>
    </title>

    <columnHeader height="26">
        <element kind="rectangle" x="0" y="0" width="782" height="24" backcolor="#E2E8F0">
            <pen lineWidth="0.0"/>
        </element>
        <element kind="staticText" x="6" y="0" width="179" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="9.0" bold="true">
            <text><![CDATA[Contrato]]></text>
        </element>
        <element kind="staticText" x="185" y="0" width="82" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="9.0" bold="true">
            <text><![CDATA[Fecha pago]]></text>
        </element>
        <element kind="staticText" x="267" y="0" width="125" height="24" forecolor="#0F172A" hTextAlign="Right" vTextAlign="Middle" fontSize="9.0" bold="true">
            <text><![CDATA[Monto original]]></text>
        </element>
        <element kind="staticText" x="392" y="0" width="125" height="24" forecolor="#0F172A" hTextAlign="Right" vTextAlign="Middle" fontSize="9.0" bold="true">
            <text><![CDATA[Monto contrato]]></text>
        </element>
        <element kind="staticText" x="524" y="0" width="78" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="9.0" bold="true">
            <text><![CDATA[Método]]></text>
        </element>
        <element kind="staticText" x="602" y="0" width="105" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="9.0" bold="true">
            <text><![CDATA[Referencia]]></text>
        </element>
        <element kind="staticText" x="707" y="0" width="70" height="24" forecolor="#0F172A" vTextAlign="Middle" fontSize="9.0" bold="true">
            <text><![CDATA[Estado]]></text>
        </element>
    </columnHeader>

    <detail>
        <band height="24">
            <element kind="textField" x="6" y="2" width="179" height="18" forecolor="#1E293B" vTextAlign="Middle" fontSize="9.0" textAdjust="StretchHeight">
                <expression><![CDATA[$F{contrato} == null || $F{contrato}.isBlank() ? "—" : $F{contrato}]]></expression>
            </element>
            <element kind="textField" x="185" y="2" width="82" height="18" forecolor="#334155" vTextAlign="Middle" fontSize="9.0">
                <expression><![CDATA[$F{fechaPago} == null ? "—" : $F{fechaPago}.toString()]]></expression>
            </element>
            <element kind="textField" x="267" y="2" width="125" height="18" forecolor="#0F172A" hTextAlign="Right" vTextAlign="Middle" fontSize="9.0">
                <expression><![CDATA[($F{montoOriginal} == null ? "0.00" : $F{montoOriginal}.toPlainString()) + ($F{monedaOriginal} == null || $F{monedaOriginal}.isBlank() ? "" : " " + $F{monedaOriginal})]]></expression>
            </element>
            <element kind="textField" x="392" y="2" width="125" height="18" forecolor="#0F172A" hTextAlign="Right" vTextAlign="Middle" fontSize="9.0">
                <expression><![CDATA[($F{montoContrato} == null ? "0.00" : $F{montoContrato}.toPlainString()) + ($F{monedaContrato} == null || $F{monedaContrato}.isBlank() ? "" : " " + $F{monedaContrato})]]></expression>
            </element>
            <element kind="textField" x="524" y="2" width="78" height="18" forecolor="#334155" vTextAlign="Middle" fontSize="9.0">
                <expression><![CDATA[$F{metodo} == null || $F{metodo}.isBlank() ? "—" : $F{metodo}]]></expression>
            </element>
            <element kind="textField" x="602" y="2" width="105" height="18" forecolor="#334155" vTextAlign="Middle" fontSize="9.0" textAdjust="StretchHeight">
                <expression><![CDATA[$F{referencia} == null || $F{referencia}.isBlank() ? "—" : $F{referencia}]]></expression>
            </element>
            <element kind="textField" x="707" y="2" width="70" height="18" forecolor="#0F172A" vTextAlign="Middle" fontSize="9.0" bold="true">
                <expression><![CDATA[$F{estado} == null || $F{estado}.isBlank() ? "—" : $F{estado}]]></expression>
            </element>
            <element kind="line" x="0" y="22" width="782" height="1" forecolor="#E2E8F0">
                <pen lineWidth="0.5"/>
            </element>
        </band>
    </detail>

    <pageFooter height="22">
        <element kind="textField" x="0" y="2" width="660" height="18" forecolor="#64748B" vTextAlign="Middle" fontSize="8.5">
            <expression><![CDATA["Latch · Documento generado automáticamente"]]></expression>
        </element>
        <element kind="textField" x="660" y="2" width="90" height="18" forecolor="#64748B" hTextAlign="Right" vTextAlign="Middle" fontSize="8.5">
            <expression><![CDATA["Página " + $V{PAGE_NUMBER} + " de "]]></expression>
        </element>
        <element kind="textField" x="750" y="2" width="32" height="18" forecolor="#64748B" vTextAlign="Middle" fontSize="8.5" evaluationTime="Report">
            <expression><![CDATA[$V{PAGE_NUMBER}]]></expression>
        </element>
    </pageFooter>
</jasperReport>