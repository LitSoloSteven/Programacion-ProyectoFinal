<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:id="rootView" fx:controller="ni.edu.uam.proyectofinalprogramacionappescritorio.controller.UnidadController"
      spacing="16.0" styleClass="view-container">
    <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="page-header">
        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
            <Label fx:id="lblTitulo" styleClass="page-title" text="Unidades" />
            <Label styleClass="page-subtitle" text="Inventario, disponibilidad y canon base." />
        </VBox>
        <Button fx:id="btnNuevo" onAction="#handleNuevo" styleClass="button-primary" text="Nueva unidad" />
    </HBox>
    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="filter-bar">
        <TextField fx:id="txtBuscar" prefWidth="360.0" promptText="Buscar por código, tipo, descripción o propiedad" styleClass="search-field" />
        <Button fx:id="btnLimpiar" onAction="#limpiarFiltros" styleClass="button-secondary" text="Limpiar" />
        <Label fx:id="lblContador" styleClass="secondary-text" text="0 registros" HBox.hgrow="ALWAYS" />
        <HBox fx:id="eliminarTooltipHost">
            <Button fx:id="btnEliminar" disable="true" onAction="#handleEliminar"
                    styleClass="button-destructive" text="Eliminar unidad" />
        </HBox>
    </HBox>
    <Label fx:id="lblErrorConsulta" managed="false" minHeight="18.0" styleClass="field-error"
           text="" visible="false" wrapText="true" />
    <TableView fx:id="tblUnidades" styleClass="data-table" VBox.vgrow="ALWAYS">
        <placeholder><Label text="Aún no hay unidades registradas." /></placeholder>
        <columns>
            <TableColumn fx:id="colPropiedad" minWidth="220.0" prefWidth="220.0" text="Propiedad" />
            <TableColumn fx:id="colCodigo" minWidth="110.0" prefWidth="110.0" text="Código" />
            <TableColumn fx:id="colTipo" minWidth="145.0" prefWidth="145.0" text="Tipo" />
            <TableColumn fx:id="colEstado" minWidth="130.0" prefWidth="130.0" text="Disponibilidad" />
            <TableColumn fx:id="colCanon" minWidth="145.0" prefWidth="145.0" text="Canon" />
            <TableColumn fx:id="colDescripcion" minWidth="210.0" prefWidth="210.0" text="Descripción" />
            <TableColumn fx:id="colAcciones" minWidth="48.0" prefWidth="48.0" maxWidth="48.0" text="" />
        </columns>
    </TableView>
</VBox>
