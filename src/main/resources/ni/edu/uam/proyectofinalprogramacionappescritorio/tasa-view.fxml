<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:id="rootView" fx:controller="ni.edu.uam.proyectofinalprogramacionappescritorio.controller.TasaController"
      spacing="16.0" styleClass="view-container">
    <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="page-header">
        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
            <Label fx:id="lblTitulo" styleClass="page-title" text="Tasas de cambio" />
            <Label styleClass="page-subtitle" text="Registro informativo y autorización de tasas NIO por USD." />
        </VBox>
        <Button fx:id="btnRefrescar" onAction="#refrescarTabla" styleClass="button-secondary" text="Actualizar" />
        <Button fx:id="btnGenerarReporte" onAction="#handleGenerarReporte"
                minWidth="USE_PREF_SIZE" styleClass="button-secondary" text="Reporte" />
        <Button fx:id="btnRegistrar" onAction="#handleRegistrar" styleClass="button-primary" text="Registrar tasa informativa" />
    </HBox>
    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="filter-bar">
        <TextField fx:id="txtBuscar" prefWidth="360.0" promptText="Buscar por fecha, fuente o estado"
                   styleClass="search-field" />
        <Button fx:id="btnLimpiar" onAction="#limpiarFiltros" styleClass="button-secondary" text="Limpiar" />
        <Label fx:id="lblContador" styleClass="secondary-text" text="0 tasas" HBox.hgrow="ALWAYS" />
        <HBox fx:id="autorizacionTooltipHost">
            <Button fx:id="btnAutorizar" disable="true" onAction="#handleAutorizar"
                    styleClass="button-secondary" text="Autorizar tasa" />
        </HBox>
    </HBox>
    <Label fx:id="lblSeleccion" managed="false" styleClass="secondary-text" text=""
           visible="false" wrapText="true" />
    <Label fx:id="lblErrorConsulta" managed="false" minHeight="18.0"
           styleClass="field-error" text="" visible="false" wrapText="true" />
    <TableView fx:id="tblTasas" styleClass="data-table" VBox.vgrow="ALWAYS">
        <placeholder><Label text="Aún no hay tasas registradas." /></placeholder>
        <columns>
            <TableColumn fx:id="colFecha" minWidth="100.0" prefWidth="100.0" text="Fecha" />
            <TableColumn fx:id="colTasa" minWidth="145.0" prefWidth="145.0" text="NIO por USD" />
            <TableColumn fx:id="colFuente" minWidth="145.0" prefWidth="145.0" text="Fuente" />
            <TableColumn fx:id="colEstado" minWidth="120.0" prefWidth="120.0" text="Estado" />
            <TableColumn fx:id="colAutorizadoPor" minWidth="150.0" prefWidth="150.0" text="Autorizador" />
            <TableColumn fx:id="colRegistrado" minWidth="145.0" prefWidth="145.0" text="Registro" />
            <TableColumn fx:id="colMotivo" minWidth="220.0" prefWidth="220.0" text="Motivo" />
            <TableColumn fx:id="colAcciones" minWidth="48.0" prefWidth="48.0" maxWidth="48.0" text="" />
        </columns>
    </TableView>
</VBox>
