<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.proyectofinalprogramacionappescritorio.controller.TasaController"
      spacing="18.0" styleClass="view-container">

    <padding>
        <Insets bottom="24.0" left="28.0" right="28.0" top="24.0" />
    </padding>

    <!-- ENCABEZADO -->
    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
            <Label styleClass="page-title" text="💱 Tasas de Cambio" />
            <Label styleClass="page-subtitle"
                   text="Registre la referencia NIO por USD y autorícela antes de usarla en pagos" />
        </VBox>
        <Button fx:id="btnRefrescar" onAction="#refrescarTabla" styleClass="btn-secondary"
                text="🔄 Refrescar" />
    </HBox>

    <!-- REGISTRO DE TASA INFORMATIVA -->
    <VBox spacing="14.0" styleClass="form-card">
        <Label styleClass="form-card-title" text="Registrar tasa informativa" />

        <GridPane hgap="16.0" vgap="12.0">
            <columnConstraints>
                <ColumnConstraints percentWidth="30.0" />
                <ColumnConstraints percentWidth="32.0" />
                <ColumnConstraints percentWidth="38.0" />
            </columnConstraints>

            <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label styleClass="form-label" text="Fecha *" />
                <DatePicker fx:id="dpFecha" maxWidth="Infinity" />
            </VBox>

            <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label styleClass="form-label" text="Tasa NIO por USD *" />
                <TextField fx:id="txtTasa" promptText="ej. 36.75000000" />
            </VBox>

            <VBox spacing="4.0" GridPane.columnIndex="2" GridPane.rowIndex="0">
                <Label styleClass="form-label" text="Fuente *" />
                <TextField fx:id="txtFuente" promptText="ej. BCN" />
            </VBox>
        </GridPane>

        <Label styleClass="form-label" wrapText="true"
               text="La tasa se guarda con ocho decimales y redondeo HALF_EVEN. Una tasa informativa no puede convertir pagos hasta que un propietario la autorice." />

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <Button onAction="#limpiarFormulario" styleClass="btn-secondary"
                    text="Limpiar Formulario" />
            <Button fx:id="btnRegistrar" onAction="#handleRegistrar" styleClass="btn-primary"
                    text="Registrar Tasa" />
        </HBox>

        <Separator />

        <Label styleClass="form-card-title" text="Autorización (solo propietario)" />
        <Label fx:id="lblSeleccion" styleClass="page-subtitle" wrapText="true"
               text="Seleccione una tasa informativa de la tabla para autorizarla." />

        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label styleClass="form-label" text="Motivo de autorización *" />
                <TextField fx:id="txtMotivo"
                           promptText="ej. Tasa oficial del BCN verificada para la fecha" />
            </VBox>
            <Button fx:id="btnAutorizar" onAction="#handleAutorizar" styleClass="btn-success"
                    text="Autorizar Tasa" />
        </HBox>
    </VBox>

    <!-- HISTORIAL -->
    <VBox spacing="8.0" VBox.vgrow="ALWAYS">
        <Label styleClass="table-title" text="Historial de Tasas Registradas" />

        <TableView fx:id="tblTasas" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colFecha" prefWidth="95.0" text="Fecha" />
                <TableColumn fx:id="colTasa" prefWidth="135.0" text="NIO por USD" />
                <TableColumn fx:id="colFuente" prefWidth="170.0" text="Fuente" />
                <TableColumn fx:id="colEstado" prefWidth="115.0" text="Estado" />
                <TableColumn fx:id="colAutorizadoPor" prefWidth="140.0" text="Autorizada por" />
                <TableColumn fx:id="colRegistrado" prefWidth="145.0" text="Registrada" />
                <TableColumn fx:id="colMotivo" prefWidth="220.0" text="Motivo" />
            </columns>
            <placeholder>
                <Label text="No hay tasas registradas. Registre la primera tasa informativa." />
            </placeholder>
        </TableView>
    </VBox>

</VBox>