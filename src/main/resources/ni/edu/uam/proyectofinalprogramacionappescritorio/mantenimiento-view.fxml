<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:id="rootView" fx:controller="ni.edu.uam.proyectofinalprogramacionappescritorio.controller.MantenimientoController"
      spacing="16.0" styleClass="view-container">
    <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="page-header">
        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
            <Label fx:id="lblTitulo" styleClass="page-title" text="Mantenimiento" />
            <Label styleClass="page-subtitle" text="Solicitudes por unidad, atención y gastos efectivos de propiedad (sin cargo automático al inquilino)." />
        </VBox>
        <Button fx:id="btnRefrescar" onAction="#refrescarDatos" styleClass="button-secondary" text="Actualizar" />
        <Button fx:id="btnGenerarReporte" onAction="#handleGenerarReporte" minWidth="-Infinity" styleClass="button-secondary" text="Reporte" />
        <Button fx:id="btnRegistrarGasto" onAction="#handleRegistrarGasto" styleClass="button-secondary" text="Registrar gasto" />
        <Button fx:id="btnNuevaSolicitud" onAction="#handleNuevaSolicitud" styleClass="button-primary" text="Nueva solicitud" />
    </HBox>
    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="filter-bar">
        <ComboBox fx:id="cmbFiltroPropiedad" prefWidth="180.0" promptText="Propiedad" styleClass="field" />
        <ComboBox fx:id="cmbFiltroUnidad" prefWidth="180.0" promptText="Unidad" styleClass="field" />
        <ComboBox fx:id="cmbFiltroPrioridad" prefWidth="130.0" promptText="Prioridad" styleClass="field" />
        <ComboBox fx:id="cmbFiltroEstado" prefWidth="140.0" promptText="Estado" styleClass="field" />
        <TextField fx:id="txtBuscar" prefWidth="200.0" promptText="Buscar descripción o responsable" styleClass="search-field" />
        <Button fx:id="btnLimpiar" onAction="#limpiarFiltros" styleClass="button-secondary" text="Limpiar" />
        <Label fx:id="lblContador" styleClass="secondary-text" text="0 registros" HBox.hgrow="ALWAYS" />
    </HBox>
    <Label fx:id="lblErrorConsulta" managed="false" minHeight="18.0" styleClass="field-error" text="" visible="false" wrapText="true" />
    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <Tab text="Solicitudes">
            <VBox spacing="10.0" styleClass="view-container">
                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="filter-bar">
                    <Button fx:id="btnEditarSolicitud" disable="true" onAction="#handleEditarSolicitud" styleClass="button-secondary" text="Editar" />
                    <Button fx:id="btnIniciarAtencion" disable="true" onAction="#handleIniciarAtencion" styleClass="button-secondary" text="Iniciar atención" />
                    <Button fx:id="btnResolver" disable="true" onAction="#handleResolver" styleClass="button-primary" text="Resolver" />
                    <Button fx:id="btnCancelarSolicitud" disable="true" onAction="#handleCancelarSolicitud" styleClass="button-destructive" text="Cancelar solicitud" />
                    <Button fx:id="btnGastoSolicitud" disable="true" onAction="#handleGastoDeSolicitud" styleClass="button-secondary" text="Agregar gasto" />
                </HBox>
                <TableView fx:id="tblSolicitudes" styleClass="data-table" VBox.vgrow="ALWAYS">
                    <placeholder><Label text="No hay solicitudes de mantenimiento." /></placeholder>
                    <columns>
                        <TableColumn fx:id="colPropiedad" minWidth="140.0" prefWidth="160.0" text="Propiedad" />
                        <TableColumn fx:id="colUnidad" minWidth="100.0" prefWidth="110.0" text="Unidad" />
                        <TableColumn fx:id="colDescripcion" minWidth="200.0" prefWidth="240.0" text="Descripción" />
                        <TableColumn fx:id="colPrioridad" minWidth="90.0" prefWidth="95.0" text="Prioridad" />
                        <TableColumn fx:id="colEstado" minWidth="105.0" prefWidth="115.0" text="Estado" />
                        <TableColumn fx:id="colResponsable" minWidth="130.0" prefWidth="150.0" text="Responsable" />
                        <TableColumn fx:id="colAbiertaEl" minWidth="100.0" prefWidth="105.0" text="Apertura" />
                        <TableColumn fx:id="colGastoUsd" minWidth="100.0" prefWidth="110.0" text="Gasto USD" />
                        <TableColumn fx:id="colGastoNio" minWidth="100.0" prefWidth="110.0" text="Gasto NIO" />
                    </columns>
                </TableView>
            </VBox>
        </Tab>
        <Tab text="Gastos de mantenimiento">
            <VBox spacing="10.0" styleClass="view-container">
                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="filter-bar">
                    <DatePicker fx:id="dpGastosDesde" promptText="Desde" />
                    <DatePicker fx:id="dpGastosHasta" promptText="Hasta" />
                    <ComboBox fx:id="cmbMonedaGasto" prefWidth="120.0" promptText="Moneda" styleClass="field" />
                    <Button fx:id="btnConsultarGastos" onAction="#consultarGastos" styleClass="button-secondary" text="Filtrar gastos" />
                    <Label fx:id="lblTotalGastosUsd" styleClass="secondary-text, numeric" text="USD 0.00" />
                    <Label fx:id="lblTotalGastosNio" styleClass="secondary-text, numeric" text="NIO 0.00" />
                </HBox>
                <TableView fx:id="tblGastos" styleClass="data-table" VBox.vgrow="ALWAYS">
                    <placeholder><Label text="No hay gastos registrados para el período." /></placeholder>
                    <columns>
                        <TableColumn fx:id="colGastoFecha" minWidth="105.0" prefWidth="115.0" text="Fecha" />
                        <TableColumn fx:id="colGastoPropiedad" minWidth="160.0" prefWidth="180.0" text="Propiedad" />
                        <TableColumn fx:id="colGastoSolicitud" minWidth="180.0" prefWidth="200.0" text="Solicitud" />
                        <TableColumn fx:id="colGastoConcepto" minWidth="200.0" prefWidth="240.0" text="Concepto" />
                        <TableColumn fx:id="colGastoMoneda" minWidth="80.0" prefWidth="90.0" text="Moneda" />
                        <TableColumn fx:id="colGastoImporte" minWidth="110.0" prefWidth="120.0" text="Importe" />
                        <TableColumn fx:id="colGastoCreador" minWidth="120.0" prefWidth="140.0" text="Registrado por" />
                    </columns>
                </TableView>
            </VBox>
        </Tab>
    </TabPane>
</VBox>
