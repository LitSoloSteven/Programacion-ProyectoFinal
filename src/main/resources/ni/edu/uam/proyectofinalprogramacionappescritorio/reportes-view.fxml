<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:id="rootView"
      fx:controller="ni.edu.uam.proyectofinalprogramacionappescritorio.controller.ReportesController"
      spacing="16.0" styleClass="view-container">

    <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="page-header">
        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
            <Label fx:id="lblTitulo" styleClass="page-title" text="Centro de Reportes" />
            <Label styleClass="page-subtitle"
                   text="Genera vista previa, PDF y XLSX tabular con filtros, corte y monedas separadas (H5)." />
        </VBox>
        <Button fx:id="btnRefrescarCatalogos" onAction="#cargarCatalogos"
                styleClass="button-secondary" text="Actualizar catálogos" minWidth="-Infinity" />
    </HBox>

    <VBox spacing="12.0" styleClass="review-panel">
        <Label styleClass="section-title" text="1. Selección del reporte" />
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <ComboBox fx:id="cmbTipoReporte" prefWidth="360.0" styleClass="field" />
            <Label fx:id="lblDescripcionReporte" styleClass="field-help" wrapText="true" HBox.hgrow="ALWAYS"
                   text="Selecciona un reporte operativo del catálogo." />
        </HBox>
        <Label styleClass="field-help" wrapText="true"
               text="Nota: REP-01 (Recibo de pago) se emite únicamente en PDF desde el módulo de Pagos. Los reportes REP-02 a REP-10 admiten PDF y XLSX." />
    </VBox>

    <VBox spacing="12.0" styleClass="review-panel">
        <Label styleClass="section-title" text="2. Parámetros y filtros" />
        <GridPane hgap="14.0" vgap="12.0">
            <columnConstraints>
                <ColumnConstraints percentWidth="33.333" hgrow="ALWAYS" />
                <ColumnConstraints percentWidth="33.333" hgrow="ALWAYS" />
                <ColumnConstraints percentWidth="33.334" hgrow="ALWAYS" />
            </columnConstraints>

            <VBox fx:id="boxFechaCorte" spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label styleClass="field-label" text="Fecha de corte / base" />
                <DatePicker fx:id="dpFechaCorte" maxWidth="Infinity" />
            </VBox>

            <VBox fx:id="boxDesde" spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label styleClass="field-label" text="Desde" />
                <DatePicker fx:id="dpDesde" maxWidth="Infinity" />
            </VBox>

            <VBox fx:id="boxHasta" spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label styleClass="field-label" text="Hasta" />
                <DatePicker fx:id="dpHasta" maxWidth="Infinity" />
            </VBox>

            <VBox fx:id="boxUmbralDias" spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label styleClass="field-label" text="Umbral (días)" />
                <TextField fx:id="txtUmbralDias" promptText="30" styleClass="field" />
            </VBox>

            <VBox fx:id="boxMoneda" spacing="4.0" GridPane.columnIndex="2" GridPane.rowIndex="0">
                <Label styleClass="field-label" text="Moneda" />
                <ComboBox fx:id="cmbMoneda" maxWidth="Infinity" styleClass="field" />
            </VBox>

            <VBox fx:id="boxPropiedad" spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                <Label styleClass="field-label" text="Propiedad" />
                <ComboBox fx:id="cmbPropiedad" maxWidth="Infinity" styleClass="field" />
            </VBox>

            <VBox fx:id="boxUnidad" spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                <Label styleClass="field-label" text="Unidad" />
                <ComboBox fx:id="cmbUnidad" maxWidth="Infinity" styleClass="field" />
            </VBox>

            <VBox fx:id="boxTipoUnidad" spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                <Label styleClass="field-label" text="Tipo de unidad" />
                <ComboBox fx:id="cmbTipoUnidad" maxWidth="Infinity" styleClass="field" />
            </VBox>

            <VBox fx:id="boxContrato" spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                <Label styleClass="field-label" text="Contrato" />
                <ComboBox fx:id="cmbContrato" maxWidth="Infinity" styleClass="field" />
            </VBox>

            <VBox fx:id="boxInquilino" spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                <Label styleClass="field-label" text="Inquilino" />
                <ComboBox fx:id="cmbInquilino" maxWidth="Infinity" styleClass="field" />
            </VBox>

            <VBox fx:id="boxEstadoMantenimiento" spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
                <Label styleClass="field-label" text="Estado de solicitud" />
                <ComboBox fx:id="cmbEstadoMantenimiento" maxWidth="Infinity" styleClass="field" />
            </VBox>

            <VBox fx:id="boxPrioridadMantenimiento" spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                <Label styleClass="field-label" text="Prioridad" />
                <ComboBox fx:id="cmbPrioridadMantenimiento" maxWidth="Infinity" styleClass="field" />
            </VBox>

            <VBox fx:id="boxOrigenTasa" spacing="4.0" GridPane.columnIndex="2" GridPane.rowIndex="1">
                <Label styleClass="field-label" text="Fuente / origen de tasa" />
                <TextField fx:id="txtOrigenTasa" promptText="Ej. BCN, ExchangeRate-API" styleClass="field" />
            </VBox>
        </GridPane>
    </VBox>

    <Label fx:id="lblEstadoH5" styleClass="field-help" managed="false" visible="false" wrapText="true" />
    <Label fx:id="lblError" styleClass="field-error" managed="false" visible="false" wrapText="true" />

    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="toolbar">
        <Button fx:id="btnVistaPrevia" onAction="#handleVistaPrevia"
                styleClass="button-primary" text="Vista previa" minWidth="-Infinity" />
        <Button fx:id="btnExportarPdf" onAction="#handleExportarPdf"
                styleClass="button-secondary" text="Exportar PDF…" minWidth="-Infinity" />
        <Button fx:id="btnExportarXlsx" onAction="#handleExportarXlsx"
                styleClass="button-secondary" text="Exportar XLSX…" minWidth="-Infinity" />
        <Button fx:id="btnCancelarH5" onAction="#handleCancelarH5"
                styleClass="button-destructive" text="Cancelar tarea"
                visible="false" managed="false" minWidth="-Infinity" />
    </HBox>
</VBox>
