<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:id="rootView" fx:controller="ni.edu.uam.proyectofinalprogramacionappescritorio.controller.InquilinoController"
      spacing="16.0" styleClass="view-container">
    <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="page-header">
        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
            <Label fx:id="lblTitulo" styleClass="page-title" text="Inquilinos" />
            <Label styleClass="page-subtitle" text="Personas registradas y sus datos de contacto." />
        </VBox>
        <Button fx:id="btnRefrescar" onAction="#refrescarTabla" styleClass="button-secondary" text="Actualizar" />
        <Button fx:id="btnGenerarReporte" onAction="#handleGenerarReporte"
                minWidth="USE_PREF_SIZE" styleClass="button-secondary" text="Reporte" />
        <Button fx:id="btnNuevo" onAction="#handleNuevo" styleClass="button-primary" text="Nuevo inquilino" />
    </HBox>
    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="filter-bar">
        <TextField fx:id="txtBuscar" prefWidth="360.0" promptText="Buscar por nombre, identificación o teléfono" styleClass="search-field" />
        <Button fx:id="btnLimpiar" onAction="#limpiarFiltros" styleClass="button-secondary" text="Limpiar" />
        <Label fx:id="lblContador" styleClass="secondary-text" text="0 registros" HBox.hgrow="ALWAYS" />
        <Button fx:id="btnDarBaja" disable="true" onAction="#handleDarDeBaja"
                styleClass="button-secondary" text="Deshabilitar" />
        <HBox fx:id="eliminarTooltipHost">
            <Button fx:id="btnEliminar" disable="true" onAction="#handleEliminar"
                    styleClass="button-destructive" text="Eliminar registro" />
        </HBox>
    </HBox>
    <Label fx:id="lblErrorConsulta" managed="false" minHeight="18.0" styleClass="field-error"
           text="" visible="false" wrapText="true" />
    <TableView fx:id="tblInquilinos" styleClass="data-table" VBox.vgrow="ALWAYS">
        <placeholder><Label text="Aún no hay inquilinos registrados." /></placeholder>
        <columns>
            <TableColumn fx:id="colNombre" minWidth="200.0" prefWidth="200.0" text="Nombre" />
            <TableColumn fx:id="colIdentificacion" minWidth="145.0" prefWidth="145.0" text="Identificación" />
            <TableColumn fx:id="colTelefono" minWidth="125.0" prefWidth="125.0" text="Teléfono" />
            <TableColumn fx:id="colCorreo" minWidth="210.0" prefWidth="210.0" text="Correo" />
            <TableColumn fx:id="colEmergencia" minWidth="210.0" prefWidth="210.0" text="Contacto de emergencia" />
            <TableColumn fx:id="colEstado" minWidth="95.0" prefWidth="95.0" text="Estado" />
            <TableColumn fx:id="colAcciones" minWidth="48.0" prefWidth="48.0" maxWidth="48.0" text="" />
        </columns>
    </TableView>
</VBox>
