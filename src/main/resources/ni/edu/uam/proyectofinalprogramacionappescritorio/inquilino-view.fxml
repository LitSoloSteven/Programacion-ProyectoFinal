<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.proyectofinalprogramacionappescritorio.controller.InquilinoController"
      spacing="18.0" styleClass="view-container">

    <padding>
        <Insets bottom="24.0" left="28.0" right="28.0" top="24.0" />
    </padding>

    <!-- ENCABEZADO -->
    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
            <Label styleClass="page-title" text="👥 Gestión de Inquilinos" />
            <Label styleClass="page-subtitle" text="Administre los arrendatarios y sus datos de contacto en PostgreSQL" />
        </VBox>
        <Button onAction="#refrescarTabla" styleClass="btn-secondary" text="🔄 Refrescar" />
    </HBox>

    <!-- FORMULARIO DE REGISTRO / EDICIÓN -->
    <VBox spacing="14.0" styleClass="form-card">
        <Label styleClass="form-card-title" text="Datos del Inquilino" />

        <GridPane hgap="16.0" vgap="12.0">
            <columnConstraints>
                <ColumnConstraints percentWidth="35.0" />
                <ColumnConstraints percentWidth="25.0" />
                <ColumnConstraints percentWidth="20.0" />
                <ColumnConstraints percentWidth="20.0" />
            </columnConstraints>

            <!-- Fila 0 -->
            <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label styleClass="form-label" text="Nombre Completo *" />
                <TextField fx:id="txtNombre" promptText="ej. Carlos Alberto Mendoza Ruiz" />
            </VBox>

            <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label styleClass="form-label" text="Cédula / Identificación" />
                <TextField fx:id="txtIdentificacion" promptText="ej. 001-150392-0004X" />
            </VBox>

            <VBox spacing="4.0" GridPane.columnIndex="2" GridPane.rowIndex="0">
                <Label styleClass="form-label" text="Teléfono Principal" />
                <TextField fx:id="txtTelefono" promptText="ej. +505 8899-7711" />
            </VBox>

            <VBox alignment="CENTER_LEFT" spacing="4.0" GridPane.columnIndex="3" GridPane.rowIndex="0">
                <Label styleClass="form-label" text="Estado" />
                <CheckBox fx:id="chkActivo" selected="true" text="Activo" />
            </VBox>

            <!-- Fila 1 -->
            <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                <Label styleClass="form-label" text="Correo Electrónico" />
                <TextField fx:id="txtCorreo" promptText="ej. carlos.mendoza@email.com" />
            </VBox>

            <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="1">
                <Label styleClass="form-label" text="Contacto de Emergencia / Referencia" />
                <TextField fx:id="txtContactoEmergencia" promptText="ej. Elena Ruiz (Madre) - +505 8811-2233" />
            </VBox>
        </GridPane>

        <!-- BOTONES DE ACCIÓN -->
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <Button onAction="#limpiarFormulario" styleClass="btn-secondary" text="Limpiar Formulario" />
            <Button fx:id="btnDarBaja" onAction="#handleDarDeBaja" styleClass="btn-secondary" text="Deshabilitar (Baja)" />
            <Button fx:id="btnEliminar" onAction="#handleEliminar" styleClass="btn-danger" text="Eliminar Registro" />
            <Button onAction="#handleGuardar" styleClass="btn-primary" text="Guardar Inquilino" />
        </HBox>
    </VBox>

    <!-- TABLA DE INQUILINOS -->
    <VBox spacing="8.0" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <Label styleClass="table-title" text="Listado de Inquilinos" HBox.hgrow="ALWAYS" />
            <TextField fx:id="txtBuscar" promptText="🔍 Buscar por nombre, cédula o teléfono..." prefWidth="320.0" />
        </HBox>

        <TableView fx:id="tblInquilinos" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colNombre" prefWidth="220.0" text="Nombre Completo" />
                <TableColumn fx:id="colIdentificacion" prefWidth="150.0" text="Identificación" />
                <TableColumn fx:id="colTelefono" prefWidth="130.0" text="Teléfono" />
                <TableColumn fx:id="colCorreo" prefWidth="200.0" text="Correo Electrónico" />
                <TableColumn fx:id="colEmergencia" prefWidth="220.0" text="Contacto Emergencia" />
                <TableColumn fx:id="colEstado" prefWidth="90.0" text="Estado" />
            </columns>
            <placeholder>
                <Label text="No hay inquilinos registrados en PostgreSQL." />
            </placeholder>
        </TableView>
    </VBox>

</VBox>
