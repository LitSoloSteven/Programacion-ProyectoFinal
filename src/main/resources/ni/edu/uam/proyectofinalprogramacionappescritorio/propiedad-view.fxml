<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.proyectofinalprogramacionappescritorio.controller.PropiedadController"
      spacing="18.0" styleClass="view-container">

    <padding>
        <Insets bottom="24.0" left="28.0" right="28.0" top="24.0" />
    </padding>

    <!-- ENCABEZADO -->
    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
            <Label styleClass="page-title" text="🏢 Gestión de Propiedades" />
            <Label styleClass="page-subtitle" text="Administre los inmuebles principales registrados en PostgreSQL" />
        </VBox>
        <Button onAction="#refrescarTabla" styleClass="btn-secondary" text="🔄 Refrescar" />
    </HBox>

    <!-- FORMULARIO DE REGISTRO / EDICIÓN -->
    <VBox spacing="14.0" styleClass="form-card">
        <Label styleClass="form-card-title" text="Datos de la Propiedad" />

        <GridPane hgap="16.0" vgap="12.0">
            <columnConstraints>
                <ColumnConstraints percentWidth="45.0" />
                <ColumnConstraints percentWidth="45.0" />
                <ColumnConstraints percentWidth="10.0" />
            </columnConstraints>

            <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label styleClass="form-label" text="Nombre del Inmueble *" />
                <TextField fx:id="txtNombre" promptText="ej. Condominio Villa Fontana" />
            </VBox>

            <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label styleClass="form-label" text="Dirección Completa *" />
                <TextField fx:id="txtDireccion" promptText="ej. Km 12 Carretera a Masaya, Managua" />
            </VBox>

            <VBox alignment="CENTER_LEFT" spacing="4.0" GridPane.columnIndex="2" GridPane.rowIndex="0">
                <Label styleClass="form-label" text="Estado" />
                <CheckBox fx:id="chkActiva" selected="true" text="Activa" />
            </VBox>
        </GridPane>

        <VBox spacing="8.0">
            <Label styleClass="form-card-title" text="Datos del Propietario" />
            <HBox spacing="16.0">
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label styleClass="form-label" text="Nombre *" />
                    <TextField fx:id="txtNombrePropietario" promptText="Nombre completo" />
                </VBox>
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label styleClass="form-label" text="Correo *" />
                    <TextField fx:id="txtCorreoPropietario" promptText="correo@ejemplo.com" />
                </VBox>
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label styleClass="form-label" text="Teléfono" />
                    <TextField fx:id="txtTelefonoPropietario" promptText="+505 0000 0000" />
                </VBox>
            </HBox>
        </VBox>

        <!-- BOTONES DE ACCIÓN -->
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <Button onAction="#limpiarFormulario" styleClass="btn-secondary" text="Limpiar Formulario" />
            <Button fx:id="btnEliminar" onAction="#handleEliminar" styleClass="btn-danger" text="Eliminar Inmueble" />
            <Button onAction="#handleGuardar" styleClass="btn-primary" text="Guardar Registro" />
        </HBox>
    </VBox>

    <!-- TABLA DE PROPIEDADES -->
    <VBox spacing="8.0" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <Label styleClass="table-title" text="Propiedades Registradas" HBox.hgrow="ALWAYS" />
            <TextField fx:id="txtBuscar" promptText="🔍 Buscar por nombre o dirección..." prefWidth="300.0" />
        </HBox>

        <TableView fx:id="tblPropiedades" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colNombre" prefWidth="240.0" text="Nombre del Inmueble" />
                <TableColumn fx:id="colDireccion" prefWidth="380.0" text="Dirección" />
                <TableColumn fx:id="colEstado" prefWidth="120.0" text="Estado" />
                <TableColumn fx:id="colFecha" prefWidth="160.0" text="Fecha Registro" />
            </columns>
            <placeholder>
                <Label text="No hay propiedades registradas en PostgreSQL." />
            </placeholder>
        </TableView>
    </VBox>

</VBox>
