<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:id="rootView" fx:controller="ni.edu.uam.proyectofinalprogramacionappescritorio.controller.PropiedadController"
      spacing="16.0" styleClass="view-container">
    <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="page-header">
        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
            <Label fx:id="lblTitulo" styleClass="page-title" text="Propiedades" />
            <Label styleClass="page-subtitle" text="Inmuebles administrados en Latch." />
        </VBox>
        <Button fx:id="btnRefrescar" onAction="#refrescarTabla" styleClass="button-secondary" text="Actualizar" />
        <Button fx:id="btnNuevo" onAction="#handleNuevo" styleClass="button-primary" text="Nueva propiedad" />
    </HBox>
    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="filter-bar">
        <TextField fx:id="txtBuscar" prefWidth="360.0" promptText="Buscar por nombre o dirección" styleClass="search-field" />
        <Button fx:id="btnLimpiar" onAction="#limpiarFiltros" styleClass="button-secondary" text="Limpiar" />
        <Label fx:id="lblContador" styleClass="secondary-text" text="0 registros" HBox.hgrow="ALWAYS" />
        <HBox fx:id="eliminarTooltipHost">
            <Button fx:id="btnEliminar" disable="true" onAction="#handleEliminar"
                    styleClass="button-destructive" text="Eliminar propiedad" />
        </HBox>
        <Button fx:id="btnGenerarReportePropiedades"
                text="📄 Reporte Propiedades"
                onAction="#handleGenerarReportePropiedades"/>
    </HBox>
    <Label fx:id="lblErrorConsulta" managed="false" minHeight="18.0" styleClass="field-error"
           text="" visible="false" wrapText="true" />
    <TableView fx:id="tblPropiedades" styleClass="data-table" VBox.vgrow="ALWAYS">
        <placeholder><Label text="Aún no hay propiedades registradas." /></placeholder>
        <columns>
            <TableColumn fx:id="colNombre" minWidth="230.0" prefWidth="230.0" text="Nombre" />
            <TableColumn fx:id="colDireccion" minWidth="380.0" prefWidth="380.0" text="Dirección" />
            <TableColumn fx:id="colEstado" minWidth="110.0" prefWidth="110.0" text="Estado" />
            <TableColumn fx:id="colFecha" minWidth="140.0" prefWidth="140.0" text="Registro" />
            <TableColumn fx:id="colAcciones" minWidth="48.0" prefWidth="48.0" maxWidth="48.0" text="" />
        </columns>
    </TableView>
</VBox>
