<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.proyectofinalprogramacionappescritorio.controller.VistaPreviaReporteController"
            styleClass="view-container, preview-root"
            prefWidth="1040.0"
            prefHeight="740.0">

    <top>
        <HBox styleClass="toolbar, preview-toolbar" spacing="8.0" alignment="CENTER_LEFT">
            <Button fx:id="btnAnterior"
                    text="Anterior"
                    styleClass="button-secondary"
                    minWidth="USE_PREF_SIZE"
                    onAction="#handleAnterior"/>
            <Label fx:id="lblPaginacion"
                   text="Página 0 de 0"
                   styleClass="secondary-text, numeric"
                   minWidth="USE_PREF_SIZE"/>
            <Button fx:id="btnSiguiente"
                    text="Siguiente"
                    styleClass="button-secondary"
                    minWidth="USE_PREF_SIZE"
                    onAction="#handleSiguiente"/>

            <Separator orientation="VERTICAL"/>

            <Button fx:id="btnZoomMenos"
                    text="-"
                    styleClass="button-secondary"
                    minWidth="USE_PREF_SIZE"
                    onAction="#handleZoomMenos"/>
            <Label fx:id="lblZoom"
                   text="100%"
                   styleClass="secondary-text, numeric"
                   minWidth="USE_PREF_SIZE"/>
            <Button fx:id="btnZoomMas"
                    text="+"
                    styleClass="button-secondary"
                    minWidth="USE_PREF_SIZE"
                    onAction="#handleZoomMas"/>
            <Button fx:id="btnZoomCien"
                    text="100%"
                    styleClass="button-secondary"
                    minWidth="USE_PREF_SIZE"
                    onAction="#handleZoomCien"/>
            <Button fx:id="btnAjustarAncho"
                    text="Ajustar ancho"
                    styleClass="button-secondary"
                    minWidth="USE_PREF_SIZE"
                    onAction="#handleAjustarAncho"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="btnExportarPdf"
                    text="Exportar PDF…"
                    styleClass="button-primary"
                    minWidth="USE_PREF_SIZE"
                    onAction="#handleExportarPdf"/>
            <Button fx:id="btnCerrar"
                    text="Cerrar"
                    styleClass="button-secondary"
                    minWidth="USE_PREF_SIZE"
                    onAction="#handleCerrar"/>
        </HBox>
    </top>

    <center>
        <StackPane styleClass="preview-viewport">
            <ScrollPane fx:id="spHoja"
                        fitToWidth="true"
                        fitToHeight="true"
                        styleClass="preview-scroll">
                <StackPane styleClass="preview-page-container">
                    <ImageView fx:id="imgPagina"
                               preserveRatio="true"
                               smooth="true"/>
                </StackPane>
            </ScrollPane>
            <Label fx:id="lblEstado"
                   styleClass="table-state-text"
                   visible="false"
                   managed="false"
                   wrapText="true"/>
        </StackPane>
    </center>
</BorderPane>
