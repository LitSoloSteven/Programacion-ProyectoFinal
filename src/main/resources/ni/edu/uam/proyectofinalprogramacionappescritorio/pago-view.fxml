<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.proyectofinalprogramacionappescritorio.controller.PagoController"
      spacing="18.0" styleClass="view-container">

    <padding>
        <Insets bottom="24.0" left="28.0" right="28.0" top="24.0" />
    </padding>

    <!-- ENCABEZADO -->
    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
            <Label styleClass="page-title" text="💵 Gestión y Registro de Pagos" />
            <Label styleClass="page-subtitle" text="Recepción de ingresos, conciliación y emisión de comprobantes en PostgreSQL" />
        </VBox>
        <Button onAction="#refrescarTabla" styleClass="btn-secondary" text="🔄 Refrescar" />
    </HBox>

    <!-- FORMULARIO DE REGISTRO DE PAGOS -->
    <VBox spacing="14.0" styleClass="form-card">
        <Label styleClass="form-card-title" text="Registrar Cobro / Ingreso" />

        <GridPane hgap="16.0" vgap="12.0">
            <columnConstraints>
                <ColumnConstraints percentWidth="35.0" />
                <ColumnConstraints percentWidth="20.0" />
                <ColumnConstraints percentWidth="15.0" />
                <ColumnConstraints percentWidth="15.0" />
                <ColumnConstraints percentWidth="15.0" />
            </columnConstraints>

            <!-- Fila 0 -->
            <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label styleClass="form-label" text="Contrato / Arrendatario *" />
                <ComboBox fx:id="cmbContrato" maxWidth="Infinity" promptText="Seleccione contrato..." />
            </VBox>

            <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label styleClass="form-label" text="Monto Pagado *" />
                <TextField fx:id="txtMonto" promptText="ej. 450.00" />
            </VBox>

            <VBox spacing="4.0" GridPane.columnIndex="2" GridPane.rowIndex="0">
                <Label styleClass="form-label" text="Moneda *" />
                <ComboBox fx:id="cmbMoneda" maxWidth="Infinity" />
            </VBox>

            <VBox spacing="4.0" GridPane.columnIndex="3" GridPane.rowIndex="0">
                <Label styleClass="form-label" text="Fecha de Pago *" />
                <DatePicker fx:id="dpFechaPago" maxWidth="Infinity" />
            </VBox>

            <VBox spacing="4.0" GridPane.columnIndex="4" GridPane.rowIndex="0">
                <Label styleClass="form-label" text="Método de Pago *" />
                <ComboBox fx:id="cmbMetodo" maxWidth="Infinity" />
            </VBox>

            <!-- Fila 1 -->
            <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                <Label styleClass="form-label" text="N° Referencia / Comprobante" />
                <TextField fx:id="txtReferencia" promptText="ej. TR-9988221 o Recibo #042" />
            </VBox>

            <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.columnSpan="4" GridPane.rowIndex="1">
                <Label styleClass="form-label" text="Observaciones / Notas" />
                <TextField fx:id="txtNotas" promptText="Detalles adicionales del abono o pago" />
            </VBox>
        </GridPane>

        <!-- BOTONES DE ACCIÓN -->
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <Button onAction="#limpiarFormulario" styleClass="btn-secondary" text="Limpiar Formulario" />
            <Button fx:id="btnAnular" onAction="#handleAnular" styleClass="btn-danger" text="Anular Pago" />
            <Button onAction="#handleRegistrar" styleClass="btn-success" text="💰 Confirmar y Guardar Pago" />
        </HBox>
    </VBox>

    <!-- TABLA DE PAGOS -->
    <VBox spacing="8.0" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <Label styleClass="table-title" text="Historial de Pagos Recibidos" HBox.hgrow="ALWAYS" />
            <TextField fx:id="txtBuscar" promptText="🔍 Buscar por contrato, referencia o método..." prefWidth="320.0" />
        </HBox>

        <TableView fx:id="tblPagos" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colContrato" prefWidth="280.0" text="Contrato / Inquilino" />
                <TableColumn fx:id="colFecha" prefWidth="120.0" text="Fecha de Pago" />
                <TableColumn fx:id="colMonto" prefWidth="140.0" text="Monto Pagado" />
                <TableColumn fx:id="colMetodo" prefWidth="140.0" text="Método" />
                <TableColumn fx:id="colReferencia" prefWidth="160.0" text="Referencia" />
                <TableColumn fx:id="colEstado" prefWidth="110.0" text="Estado" />
            </columns>
            <placeholder>
                <Label text="No hay pagos registrados en PostgreSQL." />
            </placeholder>
        </TableView>
    </VBox>

</VBox>
