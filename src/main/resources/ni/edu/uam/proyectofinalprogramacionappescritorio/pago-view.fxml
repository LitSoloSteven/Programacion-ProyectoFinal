<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:id="rootView" fx:controller="ni.edu.uam.proyectofinalprogramacionappescritorio.controller.PagoController"
      spacing="16.0" styleClass="view-container">
    <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="page-header">
        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
            <Label fx:id="lblTitulo" styleClass="page-title" text="Pagos" />
            <Label styleClass="page-subtitle" text="Registro e historial de pagos recibidos." />
        </VBox>
        <Button fx:id="btnNuevo" onAction="#handleNuevo" styleClass="button-primary" text="Registrar pago" />
    </HBox>
    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="filter-bar">
        <TextField fx:id="txtBuscar" prefWidth="360.0" promptText="Buscar por contrato, referencia o método"
                   styleClass="search-field" />
        <Button fx:id="btnLimpiar" onAction="#limpiarFiltros" styleClass="button-secondary" text="Limpiar" />
        <Label fx:id="lblContador" styleClass="secondary-text" text="0 pagos" HBox.hgrow="ALWAYS" />
        <HBox fx:id="anularTooltipHost">
            <Button fx:id="btnAnular" disable="true" onAction="#handleAnular"
                    styleClass="button-destructive" text="Anular pago" />
        </HBox>
    </HBox>
    <Label fx:id="lblErrorConsulta" managed="false" minHeight="18.0"
           styleClass="field-error" text="" visible="false" wrapText="true" />
    <TableView fx:id="tblPagos" styleClass="data-table" VBox.vgrow="ALWAYS">
        <placeholder><Label text="Aún no hay pagos registrados." /></placeholder>
        <columns>
            <TableColumn fx:id="colContrato" minWidth="220.0" prefWidth="220.0" text="Contrato / inquilino" />
            <TableColumn fx:id="colFecha" minWidth="120.0" prefWidth="120.0" text="Fecha" />
            <TableColumn fx:id="colMonto" minWidth="140.0" prefWidth="140.0" text="Monto" />
            <TableColumn fx:id="colMetodo" minWidth="135.0" prefWidth="135.0" text="Método" />
            <TableColumn fx:id="colReferencia" minWidth="155.0" prefWidth="155.0" text="Referencia" />
            <TableColumn fx:id="colEstado" minWidth="110.0" prefWidth="110.0" text="Estado" />
            <TableColumn fx:id="colAcciones" minWidth="48.0" prefWidth="48.0" maxWidth="48.0" text="" />
        </columns>
    </TableView>
    <HBox alignment="CENTER_RIGHT" spacing="12.0" styleClass="pagination-bar">
        <Label fx:id="lblPaginacion" styleClass="secondary-text" text="0–0 de 0 pagos" />
        <Button fx:id="btnPaginaAnterior" disable="true" onAction="#paginaAnterior"
                minWidth="32.0" prefWidth="92.0" styleClass="button-secondary" text="Anterior" />
        <Button fx:id="btnPaginaSiguiente" disable="true" onAction="#paginaSiguiente"
                minWidth="32.0" prefWidth="92.0" styleClass="button-secondary" text="Siguiente" />
    </HBox>
</VBox>
